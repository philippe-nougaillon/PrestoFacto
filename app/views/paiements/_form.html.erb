<%= form_with(model: paiement, local: true) do |form| %>

  <% if paiement.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(paiement.errors.count, "erreur") %> empêche(nt) la sauvegarde du paiement :</h2>

      <ul>
        <% paiement.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :compte_id %>

  <div class="flex flex-wrap -mx-2">
    <div class="flex-1 px-2">
      <div class="flex flex-wrap -mx-2">
        <div class="flex-1 px-2"><%= form.date_field :date, required: true %></div>
        <div class="flex-1 px-2"><%= form.text_field :réf %></div>
        <div class="flex-1 px-2"><%= form.select :mode, Paiement.modes %></div>
      </div>
      <div class="flex flex-wrap -mx-2">
        <div class="flex-1 px-2"><%= form.select :banque, Paiement.banques, include_blank: true %></div>
        <div class="flex-1 px-2"><%= form.text_field :chèque_num, label: 'Chèque N°' %></div>
      </div>
      <div class="flex flex-wrap -mx-2">
        <div class="flex-1 px-2"><%= form.number_field :montant, step: :any %></div>
        <div class="flex-1 px-2"><%= form.date_field :date_remise %></div>
      </div>
      <%= form.text_area :mémo %>
      <%= form.submit "Enregistrer", class: "btn btn-outline btn-success mr-2", 'data-turbo': false %>
      <%= link_to 'Annuler', paiements_path %>
    </div>
  </div>

<% end %>
