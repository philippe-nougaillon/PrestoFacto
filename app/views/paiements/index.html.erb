<div class="flex items-center pb-6 mt-6 mb-2">
  <h2 class="font-light inline mb-0 whitespace-nowrap">
    <%= mi_icon 'money-bill-alt', class: 'text-success' %> 
    Paiements
  </h2>
  <%= link_to guide_path(anchor: "paiements") do %>
    <%= mi_icon 'question-circle', type: :regular, title: "Ouvrir l'aide", class: 'text-slate-400 mx-4 text-2xl' %>
  <% end %>
</div>

<%= form_with url: paiements_path, method: :get do |f| %>
  <div class="flex flex-wrap -mx-2 items-center mb-6 p-4 mx-0 shadow-sm">
    <div class="flex-1 px-2"><%= f.text_field :nom, value: params[:nom], label:"Nom du compte/Référence", onchange: "this.form.submit()", autofocus: false %></div>
    <div class="w-full sm:w-3/12 px-2"><%= f.select :structure_id, options_from_collection_for_select(@structures, 'id', 'nom', params[:structure_id]), { include_blank: true, label: "Structure" }, { class: "selectpicker", onchange: "this.form.submit()" } %></div>
    <div class="w-full sm:w-2/12 px-2"><%= f.date_field :date_début, value: params[:date_début], onchange: "this.form.submit()" %></div>
    <div class="w-full sm:w-2/12 px-2"><%= f.date_field :date_fin, value: params[:date_fin], onchange: "this.form.submit()" %></div>
    <div class="w-full sm:w-2/12 px-2"><%= f.select :mode, options_for_select(Paiement.modes, params[:mode]), { include_blank: true}, onchange: "this.form.submit()" %></div>
  </div>
<% end %>

<div class="overflow-x-auto">
  <table class="table border border-slate-200 shadow-sm">
    <thead>
      <tr>
        <th><%= sort_link 'paiements.date', 'Date' %></th>
        <th><%= sort_link 'comptes.nom', 'Compte' %></th>
        <th><%= sort_link 'paiements.réf', 'Référence' %></th>
        <th><%= sort_link 'paiements.mode', 'Mode' %></th>
        <th><%= sort_link 'paiements.banque', 'Banque' %></th>
        <th><%= sort_link 'paiements.chèque_num', 'Chèque N°' %></th>
        <th><%= sort_link 'paiements.montant', 'Montant' %></th>
        <th><%= sort_link 'paiements.date_remise', 'Date remise' %></th>
        <th><%= sort_link 'paiements.mémo', 'Mémo' %></th>
        <th colspan="2"></th>
      </tr>
    </thead>

    <tbody>
      <%= render @paiements.includes(:compte) %>
    </tbody>
  </table>
</div>

<div class="mt-2">
  <%= page_entries_info @paiements, entry_name: 'paiement' %>
  <%= paginate @paiements %>

  <% if policy(Paiement).to_xls? && !@paiements.size.zero? %>
    <%= link_to url_for(params.permit(:structure_id, :date_début, :date_fin, :mode, :search).merge(format: :xls)),
                class: "inline-flex items-center sm:float-right text-success no-underline hover:underline" do %>
      <%= mi_icon "file-excel", class: 'mr-1' %> Export XLS
    <% end %>
  <% end %>
</div>