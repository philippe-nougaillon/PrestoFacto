<div class="flex items-center pb-6 mt-6 mb-2">
  <h2 class="font-light inline mb-0 whitespace-nowrap">
    <%= embedded_svg "icons/payments.svg", class: "w-5 h-5 text-success inline align-[-3px]" %> 
    Paiements
  </h2>
  <%= link_to guide_path(anchor: "paiements") do %>
    <%= embedded_svg "icons/help.svg", class: "w-6 h-6 text-slate-400 mx-4 inline", title: "Ouvrir l'aide" %>
  <% end %>
</div>

<%= form_with url: paiements_path, method: :get do |f| %>
  <div class="flex flex-wrap -mx-2 items-center mb-6 p-4 mx-0 shadow-sm">
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= f.label :nom, "Nom du compte/Référence", class: "fieldset-legend" %>
        <%= f.text_field :nom, value: params[:nom], onchange: "this.form.submit()", autofocus: false, class: "input w-full" %>
      </fieldset>
    </div>
    <div class="w-full sm:w-3/12 px-2">
      <fieldset class="fieldset">
        <%= f.label :structure_id, "Structure", class: "fieldset-legend" %>
        <%= f.select :structure_id, options_from_collection_for_select(@structures, 'id', 'nom', params[:structure_id]), { include_blank: true }, { onchange: "this.form.submit()", class: "select w-full" } %>
      </fieldset>
    </div>
    <div class="w-full sm:w-2/12 px-2">
      <fieldset class="fieldset">
        <%= f.label :date_début, class: "fieldset-legend" %>
        <%= f.date_field :date_début, value: params[:date_début], onchange: "this.form.submit()", class: "input w-full" %>
      </fieldset>
    </div>
    <div class="w-full sm:w-2/12 px-2">
      <fieldset class="fieldset">
        <%= f.label :date_fin, class: "fieldset-legend" %>
        <%= f.date_field :date_fin, value: params[:date_fin], onchange: "this.form.submit()", class: "input w-full" %>
      </fieldset>
    </div>
    <div class="w-full sm:w-2/12 px-2">
      <fieldset class="fieldset">
        <%= f.label :mode, class: "fieldset-legend" %>
        <%= f.select :mode, options_for_select(Paiement.modes, params[:mode]), { include_blank: true }, { onchange: "this.form.submit()", class: "select w-full" } %>
      </fieldset>
    </div>
  </div>
<% end %>

<div class="overflow-x-auto">
  <table class="table border border-slate-200 shadow-sm">
    <thead>
      <tr>
        <th><%= sort_link 'paiements.date', 'Date' %></th>
        <th><%= sort_link 'comptes.nom', 'Compte' %></th>
        <th><%= sort_link 'paiements.réf', 'Référence' %></th>
        <th><%= sort_link 'paiements.mode', 'Mode' %></th>
        <th><%= sort_link 'paiements.banque', 'Banque' %></th>
        <th><%= sort_link 'paiements.chèque_num', 'Chèque N°' %></th>
        <th><%= sort_link 'paiements.montant', 'Montant' %></th>
        <th><%= sort_link 'paiements.date_remise', 'Date remise' %></th>
        <th><%= sort_link 'paiements.mémo', 'Mémo' %></th>
        <th colspan="2"></th>
      </tr>
    </thead>

    <tbody>
      <%= render @paiements.includes(:compte) %>
    </tbody>
  </table>
</div>

<div class="mt-2">
  <%= page_entries_info @paiements, entry_name: 'paiement' %>
  <%= paginate @paiements %>

  <% if policy(Paiement).to_xls? && !@paiements.size.zero? %>
    <%= link_to url_for(params.permit(:structure_id, :date_début, :date_fin, :mode, :search).merge(format: :xls)),
                class: "inline-flex items-center sm:float-right text-success no-underline hover:underline" do %>
      <%= embedded_svg "icons/table_view.svg", class: "w-5 h-5 mr-1 inline" %> Export XLS
    <% end %>
  <% end %>
</div>