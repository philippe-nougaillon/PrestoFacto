<div class="flex items-center pb-6 mt-6 mb-2">
  <h2 class="font-light inline mb-0 whitespace-nowrap">
    <%= mi_icon 'calendar-check', class: "text-success" %> 
    Pointages
    <% unless params[:date].blank? %>
      du <%= l params[:date].to_date %>
    <% end %>
  </h2>
  <%= link_to guide_path(anchor: "pointage") do %>
    <%= mi_icon 'question-circle', type: :regular, title: "Ouvrir l'aide", class: 'text-slate-400 mx-4 text-2xl' %>
  <% end %>
</div>

<%= form_with url: pointages_path, method: :get do |f| %>
  <div class="flex flex-wrap -mx-2 items-center mb-6 p-4 mx-0 shadow-sm">
    <div class="w-full sm:w-2/12 px-2">
      <fieldset class="fieldset">
        <%= f.label :date, class: "fieldset-legend" %>
        <%= f.date_field :date, value: params[:date], onchange: "this.form.submit()", class: "input w-full" %>
      </fieldset>
    </div>
    <div class="w-full sm:w-2/12 px-2">
      <fieldset class="fieldset">
        <%= f.label :prestation_type_id, "Prestation", class: "fieldset-legend" %>
        <%= f.select :prestation_type_id, options_from_collection_for_select(@prestation_types, 'id', 'nom', params[:prestation_type_id]), { include_blank: true }, { onchange: "this.form.submit()", class: "select w-full" } %>
      </fieldset>
    </div>
    <div class="w-full sm:w-2/12 px-2">
      <fieldset class="fieldset">
        <%= f.label :classroom_id, "Classe", class: "fieldset-legend" %>
        <%= f.select :classroom_id, options_from_collection_for_select(@classrooms, 'id', 'nom', params[:classroom_id]), { include_blank: true }, { onchange: "this.form.submit()", class: "select w-full" } %>
      </fieldset>
    </div>
  </div>
<% end %>

<%= form_with url: action_pointages_path, method: :post do %>
  <div data-controller="action">
    <div id="pointages" class="overflow-x-auto">
      <table class="table table-zebra border border-slate-200 shadow-sm">
        <thead style="vertical-align: middle;">
          <th></th>
          <th><%= sort_link 'enfants.nom', 'Enfant' %></th>
          <th><%= sort_link 'prestation_types.nom', 'Type prestation' %></th>
          <th><%= sort_link 'pointages.date_pointage', 'Date pointage' %></th>
          <th><%= sort_link 'pointages.heure_pointage', 'Heure pointage' %></th>
          <th><small class="font-bold text-slate-800">Minutes consommées</small></th>
          <th><small class="font-bold text-slate-800">Tranches consommées</small></th>
          <th><%= sort_link 'pointages.updated_at', 'MàJ' %></th>
          <th></th>
        </thead>
        <tbody>
          <%= render @pointages %>
        </tbody>
      </table>

    </div>
    <div class="flex flex-wrap -mx-2">
      <div class="w-full sm:w-4/12 px-2">
        <div class="join">
          <%= select_tag :action_name, 
                          options_for_select(["Pointer les arrivées/départs à l'instant T"]), 
                          include_blank: true, 
                          class: 'select select-bordered select-sm join-item w-full',
                          data: { 'action-target': 'selector' } %>
            <%= submit_tag 'ok',  name: 'action', 
                                  class: 'btn btn-sm btn-outline btn-success join-item',
                                  data: {'action-target': 'button'} %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<div class="mt-2">
  <%= page_entries_info @pointages, entry_name: 'pointage' %>
  <%= paginate @pointages %>
</div>