<%= form_with(model: vacance) do |form| %>
  <% if vacance.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(vacance.errors.count, "error") %> prohibited this vacance from being saved:</h2>

      <ul>
        <% vacance.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <fieldset class="fieldset">
      <%= form.label :zone, class: "fieldset-legend" %>
      <%= form.text_field :zone, class: "input w-full" %>
    </fieldset>
  </div>

  <div class="field">
    <fieldset class="fieldset">
      <%= form.label :nom, class: "fieldset-legend" %>
      <%= form.text_field :nom, class: "input w-full" %>
    </fieldset>
  </div>

  <div class="field">
    <fieldset class="fieldset">
      <%= form.label :début, class: "fieldset-legend" %>
      <%= form.date_select :début, {}, { class: "select" } %>
    </fieldset>
  </div>

  <div class="field">
    <fieldset class="fieldset">
      <%= form.label :fin, class: "fieldset-legend" %>
      <%= form.date_select :fin, {}, { class: "select" } %>
    </fieldset>
  </div>

  <div class="field">
    <fieldset class="fieldset">
      <%= form.label :organisation_id, class: "fieldset-legend" %>
      <%= form.text_field :organisation_id, class: "input w-full" %>
    </fieldset>
  </div>

  <div class="actions">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
