<div class="pb-2 mt-6 mb-2 border-b border-slate-200">
  <h2 class="font-light"><%= mi_icon 'balance-scale' %> Balance</h2>
</div>

<p>
	<h3>Compte: <%= @compte.nom %></h3> 
	Solde à ce jour: <%= number_to_currency(@solde, unit:'€') %>
</p>
<div class="overflow-x-auto">
	<table class="table table-zebra border border-slate-200">

		<thead>
			<th>Date</th>
			<th>Type</th>
			<th>Référence</th>
			<th class="text-right">Débit</th>
			<th class="text-right">Crédit</th>
			<th class="text-right">Solde</th>
		</thead>

		<tbody>
			<% @releve.each do |ligne| %>
				<%= render partial: 'balance', locals: { ligne: ligne } %>
			<% end %>
			</tbody>

		<tfoot>
			<tr>
				<th><%= l Date.today %></th>
				<th>SOLDE</th>
				<th></th>
				<th class="text-right"><%= number_to_currency(@debit, unit:'€') %></th>
				<th class="text-right"><%= number_to_currency(@credit, unit:'€') %></th>
				<th class="text-right"><%= number_to_currency(@solde, unit:'€') %></th>
			</tr>
		</tfoot>
		
	</table>
</div>