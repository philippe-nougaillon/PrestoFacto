<div class="pb-6 mt-6 mb-2">
  <% if policy(Compte).new? %>
    <%= link_to new_compte_path, class: 'btn btn-outline btn-primary float-right' do %>
      <%= embedded_svg "icons/add_circle.svg", class: "w-5 h-5 inline" %> Ajouter un Compte
    <% end %>
  <% end %>
  <div class="flex items-center">
    <h2 class="font-light inline mb-0 whitespace-nowrap"><%= embedded_svg "icons/groups.svg", class: "w-5 h-5 inline align-[-5px]" %> Comptes</h2>
    <%= link_to guide_path(anchor: "ajout_famille") do %>
      <%= embedded_svg "icons/help.svg", class: "w-6 h-6 text-slate-400 mx-4 mb-1 inline", title: "Ouvrir l'aide" %>
    <% end %>
  </div>
</div>

<%= form_with url: comptes_path, method: :get do |f| %>
  <div class="flex flex-wrap -mx-2 items-center mb-6 p-4 mx-0 shadow-sm">
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= f.label :search, 'Rechercher', class: "fieldset-legend" %>
        <%= f.text_field :search, value: params[:search], placeholder: 'Entrez un terme à rechercher (ex: Nom, Prénom enfant, Code postal, Ville, Numéro allocataire, Badge)', onchange: 'this.form.submit()', autofocus: false, class: "input w-full" %>
      </fieldset>
    </div>
  </div>
<% end %>

<div class="overflow-x-auto">
  <table class="table border border-slate-200 shadow-sm">
    <thead>
      <tr style="vertical-align: middle;">
        <th><%= sort_link 'comptes.nom', 'Nom' %></th>
        <th><%= sort_link 'comptes.enfants_count', 'Enfants' %></th>
        <th><%= sort_link 'comptes.adresse1', 'Adresse' %></th>
        <th><%= sort_link 'comptes.cp', 'CP'%></th>
        <th><%= sort_link 'comptes.ville', 'Ville' %></th>
        <th><small class="font-bold text-slate-800">Solde</small></td>
        <th colspan="2"></th>
      </tr>
    </thead>

    <tbody>
      <%= render @comptes %>
    </tbody>

  </table>
</div>

<div class="mt-2">
  <%= page_entries_info @comptes, entry_name: 'compte' %>
  <%= paginate @comptes %>

  <% if policy(Compte).to_xls? && !@comptes.size.zero? %>
    <%= link_to url_for(params.permit(:search).merge(format: :xls)),
                class: "inline-flex items-center sm:float-right text-success no-underline hover:underline" do %>
        <%= embedded_svg "icons/table_view.svg", class: "w-5 h-5 mr-1 inline" %> Export XLS
    <% end %>
  <% end %>
</div>
