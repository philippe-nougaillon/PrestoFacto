<div class="nested-form-wrapper" data-new-record="<%= f.object.new_record? %>">
  <div class="flex flex-wrap -mx-2">
      <div class="flex-1 px-2"><%= f.text_field :nom, label_as_placeholder: true, required: true %></div>
      <div class="flex-1 px-2"><%= f.email_field :email, label_as_placeholder: true, required: true %></div>
  </div>
  <div class="flex flex-wrap -mx-2">
    <div class="flex-1 px-2"><%= f.text_field :fixe, label_as_placeholder: true %></div>
    <div class="flex-1 px-2"><%= f.text_field :portable, label_as_placeholder: true %></div>
    <div class="flex-1 px-2"><%= f.check_box :prevenir, label_as_placeholder: true, label: "Personne à prévenir en cas d'urgence" %></div>
    <div class="w-1/12 px-2"><a type="button" data-action="nested-form#remove"><%= mi_icon 'trash-alt', class:"text-error mt-4" %></a></div>
  </div>
  <hr>
  <%= f.hidden_field :_destroy %>
</div>