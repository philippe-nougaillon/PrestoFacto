<div class="nested-form-wrapper" data-new-record="<%= f.object.new_record? %>">
  <div class="flex flex-wrap -mx-2">
      <div class="flex-1 px-2">
        <fieldset class="fieldset">
          <%= f.label :nom, class: "fieldset-legend" %>
          <%= f.text_field :nom, required: true, class: "input w-full" %>
        </fieldset>
      </div>
      <div class="flex-1 px-2">
        <fieldset class="fieldset">
          <%= f.label :email, class: "fieldset-legend" %>
          <%= f.email_field :email, required: true, class: "input w-full" %>
        </fieldset>
      </div>
  </div>
  <div class="flex flex-wrap -mx-2">
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= f.label :fixe, class: "fieldset-legend" %>
        <%= f.text_field :fixe, class: "input w-full" %>
      </fieldset>
    </div>
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= f.label :portable, class: "fieldset-legend" %>
        <%= f.text_field :portable, class: "input w-full" %>
      </fieldset>
    </div>
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= f.label :prevenir, class: "label" do %>
          <%= f.check_box :prevenir, class: "checkbox checkbox-primary" %>
          Personne à prévenir en cas d&#39;urgence
        <% end %>
      </fieldset>
    </div>
    <div class="w-1/12 px-2"><a type="button" data-action="nested-form#remove"><%= mi_icon 'trash-alt', class:"text-error mt-4" %></a></div>
  </div>
  <hr>
  <%= f.hidden_field :_destroy %>
</div>