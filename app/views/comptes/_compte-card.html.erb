<div class="flex flex-wrap -mx-2">
  <div class="w-full sm:w-5/12 px-2">
    <p>
      <strong>Nom :</strong>
      <%= @compte.civilité %>
      <%= @compte.nom %>
    </p>

    <p>
      <strong>Adresse :</strong>
      <%= @compte.adresse1 %>
      <%= @compte.adresse2 %>
    </p>

    <p>
      <strong>Ville :</strong>
      <%= @compte.cp %> <%= @compte.ville %>
    </p>

    <% unless current_user.visiteur? %>
      <p>
        <strong>#Allocataire :</strong>
        <%= @compte.num_allocataire %>
      </p>

      <p>
        <strong>Mémo :</strong>
        <%= @compte.mémo %>
      </p>
    <% end %>
    
    <% if policy(@compte).edit? %>
      <%= link_to edit_compte_path(@compte), class: "btn btn-outline btn-primary" do %>
        <%= embedded_svg "icons/edit.svg", class: "w-5 h-5 inline" %> Éditer compte
      <% end %>
    <% end %>

  </div>

  <div class="flex-1 px-2">

    <div class="card border border-slate-200">
      <div class="card-body">
        <strong>Contacts</strong>
        <div class="overflow-x-auto">
          <table class="table table-borderless table-sm">
            <% @compte.contacts.each do |contact| %>
              <tr class="row-hover alert <%= 'alert-warning' if contact.prevenir? %>">
                <td><%= contact.nom.humanize %></td>
                <td><%= mail_to contact.email, class:"text-break" %></td>
                <td><%= [contact.fixe, contact.portable].join(' ') %></td>
                <td><%= contact.mémo %></td>
              </tr>
            <% end %>
          </table>
        </div>
      </div>
    </div>

    <div class="card border border-slate-200">
      <div class="card-body flex flex-row flex-wrap items-center gap-3">
        <div>
          <strong>Factures : </strong>
          <%= number_to_currency(@total_factures, unit: '€', precision: 2, format: "%n %u")  %>
        </div>
        |
        <div>
          <strong>Paiements : </strong>
          <%= number_to_currency(@total_paiements, unit: '€', precision: 2, format: "%n %u")  %>
        </div>
        | 
        <div>
          <strong>Solde : </strong>
          <span class="<%= 'text-error' if @solde.negative? %>">
            <%= number_to_currency(@solde, unit: '€', precision: 2, format: "%n %u") %>
          </span>
        </div>
      </div>

      <% unless current_user.visiteur? %>
        <div class="card-actions px-6 pb-5 flex justify-between border-t border-slate-200 pt-5">
          <% if policy(Facture).new? %>
            <div>
              <%= link_to admin_ajout_factures_path(compte_id: @compte.id), class: "btn btn-sm btn-ghost", title: 'Lance la facturation des prestations sur une période' do %>
                <%= embedded_svg "icons/description.svg", class: "w-5 h-5 text-info mr-1 inline" %> Facturer
              <% end %>
            </div>
          <% end %>
          |
          <% if policy(Facture).new? %>
            <div>
              <%= link_to new_facture_path(compte_id: @compte.id), class: "btn btn-sm btn-ghost", title: 'Créer une nouvelle facture manuelle' do %>
                <%= embedded_svg "icons/description.svg", class: "w-5 h-5 text-info mr-1 inline" %> Nouvelle facture spéciale
              <% end %>
            </div>
          <% end %>
          |
          <% if policy(Paiement).new? %>
            <div>
              <button type="button" onclick="myModalNewPaiement.showModal()" class="btn btn-sm btn-ghost">
                <%= embedded_svg "icons/payments.svg", class: "w-5 h-5 text-success inline" %> Ajouter un paiement
              </button>
            </div>
          <% end %>
          | 
          <% if policy(@compte).balance? %>
            <div>
              <%= link_to compte_balance_path(@compte), class: "btn btn-sm btn-ghost" do %>
                <%= embedded_svg "icons/balance.svg", class: "w-5 h-5 mr-1 inline" %> Balance
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>
</div>