<div class="pb-2 mt-6 mb-2 border-b border-slate-200">
  <h2 class="font-light"><%= embedded_svg "icons/today.svg", class: "w-5 h-5 inline align-[-2px]" %> Comptabilisation des prestations</h2>
</div>

<p>
    <h4>Lancer la routine journalière de comptabilisation des prestations consommées</h4>
    <small>
      Cette fonction balaye l'ensemble des réservations prévues pour une date 
      et crée les lignes 'prestations' adéquates (si les paramètres concordes; jour de la semaine, Scolaire/HorsScolaire, absences...).
      Notez que cette routine est lancée chaque matin, automatiquement, pour comptabiliser les prestations effectuées la veille.  
    </small>
</p>
<br />

<%= form_with(url: 'ajout_prestations_do') do |form| %>
    <div class="w-full sm:w-3/12 px-2">
      <fieldset class="fieldset">
        <%= form.label :date, class: "fieldset-legend" %>
        <%= form.date_field :date, class: "input w-full" %>
      </fieldset>
    </div>
    <br>
    <fieldset class="fieldset">
      <%= form.label :enregistrer, class: "label" do %>
        <%= form.check_box :enregistrer, class: "checkbox checkbox-primary" %>
        Enregistrer les changements ? (Décoché = Visualisation seulement. Ne fait rien de définitif :)
      <% end %>
    </fieldset>  
    <br /><br />
    <%= form.submit "Lancer", class: "btn btn-outline btn-success", 'data-turbo': false %>
<% end %>


