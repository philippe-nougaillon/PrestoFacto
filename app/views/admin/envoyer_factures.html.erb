<div class="pb-2 mt-6 mb-2 border-b border-slate-200">
  <h2 class="font-light"><%= embedded_svg "icons/today.svg", class: "w-5 h-5 inline align-[-2px]" %> Envoyer les factures</h2>
</div>

<p>
  <h4>Permet l'envoi automatique, par email, de toutes les factures en état 'vérifiée'.</h4>
  <small>L'adresse du destinataire est celle du premier contact du compte.</small>
</p>
<br />

<%= form_with(url: "envoyer_factures_do", method: :post, local: true) do |form| %>
  <fieldset class="fieldset">
    <%= form.label :envoyer, class: "label" do %>
      <%= form.check_box :envoyer, class: "checkbox checkbox-primary" %>
      Envoyer les emails ? (Décoché = Visualisation seulement. Ne fait rien de définitif :)
    <% end %>
  </fieldset>  
  <br /><br />
  <%= form.submit "Lancer", class: "btn btn-outline btn-success", 'data-turbo': false %>
<% end %>


