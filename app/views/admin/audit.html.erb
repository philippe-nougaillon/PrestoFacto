<div class="pb-2 mt-6 mb-2 border-b border-slate-200">
  <h2 class="font-light"><%= mi_icon 'search' %> Audit des modifications</h2>
</div>

<%= form_with url: admin_audit_path, method: :get do |f| %>
  <div class="flex flex-wrap -mx-2">
    <div class="w-full sm:w-2/12 px-2">
      <fieldset class="fieldset">
        <%= f.label :date, class: "fieldset-legend" %>
        <%= f.date_field :date, value: params[:date], onchange: "this.form.submit()", class: "input w-full" %>
      </fieldset>
    </div>
    <div class="w-full sm:w-3/12 px-2">
      <fieldset class="fieldset">
        <%= f.label :user_id, "Utilisateur", class: "fieldset-legend" %>
        <%= f.select :user_id, options_from_collection_for_select(@users, 'id', 'email', params[:user_id]), { include_blank: true }, { onchange: "this.form.submit()", class: "select w-full" } %>
      </fieldset>
    </div>
    <div class="w-full sm:w-2/12 px-2">
      <fieldset class="fieldset">
        <%= f.label :type, "Type", class: "fieldset-legend" %>
        <%= f.select :type, options_for_select(@types, params[:type]), { include_blank: true }, { onchange: "this.form.submit()", class: "select w-full" } %>
      </fieldset>
    </div>
  </div>
<% end %>

<div class="overflow-x-auto">
  <table class="table border border-slate-200 table-sm">
      <thead>
          <tr>
              <th>Date</th>
              <th>Utilisateur</th>            
              <th>Type</th>
              <th>id</th>
              <th>Action</th>
              <th>Modifications</th>
          </tr>
      </thead>
      <%= render partial: 'audit', collection: @audits.includes(:user) %>
  </table>
</div>

<%= page_entries_info @audits, entry_name: 'audit' %>
<%= paginate @audits %>
