<div class="pb-2 mt-6 mb-2 border-b border-slate-200">
  <h2 class="font-light inline"><%= embedded_svg "icons/euro_symbol.svg", class: "w-5 h-5 inline align-[-3px]" %> Prestations et Tarifs</h2>
  <%= link_to guide_path(anchor: "tarifs") do %>
    <%= embedded_svg "icons/help.svg", class: "w-5 h-5 text-slate-500 mx-2 inline", title: "Ouvrir l'aide" %>
  <% end %>
</div>
<p>
  <small class="text-slate-500">
  Pour ajouter une prestation de 'Garderie' au Tarif 'Général' : 
  il faut ajouter un type de prestation 'Garderie' 
  et créer un Tarif qui associe 'Garderie' + 'Général' + 'Prix de la prestation (€)'.
  </small>
</p>

<div class="overflow-x-auto">
  <table class="table">
    <thead>
      <tr>
      <th>Nom du type de Tarif</th>
      <th>Nom du type de Prestation</th>
      <th>Prix</th>  
      <th></th>
      </tr>
    </thead>

    <% @organisation.tarifs.each do | tarif | %>
      <tr>
      <td><%= tarif.tarif_type.nom %></td>
      <td><%= tarif.prestation_type.nom %></td>
      <td><%= number_to_currency(tarif.prix, unit: '€', precision: 2, format: "%n %u") %></td>
      <td>
        <% if policy(tarif).destroy? %>
          <%= button_to tarif, method: :delete, 'data-turbo-confirm': 'Êtes-vous bien certain.e ???', class:'btn btn-sm btn-ghost' do %>
            <%= embedded_svg "icons/delete.svg", class: "w-5 h-5 text-error inline" %>
          <% end %>
        <% end %>
      </td>
      </tr>
    <% end %>
  </table>
</div>

<% if policy(Tarif).new? %>
  <button type="button" onclick="myModalTarif.showModal()" class="btn btn-outline btn-primary mb-12">
    <%= embedded_svg "icons/add_circle.svg", class: "w-5 h-5 inline" %> Créer un nouveau tarif
  </button>
<% end %>

<div class="flex flex-wrap -mx-2">

  <div class="flex-1 px-2">
    <h3 class="font-light">Types de prestations</h3>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Nom</th>
            <th></th>
          </tr>
        </thead>
        <% @organisation.prestation_types.each do |prestation_type| %>
          <tr>
            <td><%= link_to prestation_type.nom.humanize, edit_prestation_type_path(prestation_type) %></td>
            <td class="text-right w-full sm:w-1/12 px-2">
              <% if policy(prestation_type).destroy? %>
                <%= button_to prestation_type, method: :delete, 'data-turbo-confirm': 'Êtes-vous bien certain.e ???', class:'btn btn-sm btn-ghost p-0' do %>
                  <%= embedded_svg "icons/delete.svg", class: "w-4 h-4 text-error inline" %>
                <% end %>
              <% else %>
                <%= embedded_svg "icons/delete.svg", class: "w-5 h-5 text-slate-500 inline", title: "Pas supprimable : il y a des données liées dans Réservations, Prestations, ou Tarifs" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>
    </div>

    <% if policy(PrestationType).new? %>
      <button type="button" onclick="myModalTypePresta.showModal()" class="btn btn-outline btn-primary">
        <%= embedded_svg "icons/add_circle.svg", class: "w-5 h-5 inline" %> Ajouter un type de prestation
      </button>
    <% end %>
  </div>

  <div class="flex-1 px-2">
    <h3 class="font-light">Types de tarifs</h3>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Nom</th>
            <th></th>
          </tr>
        </thead>
        <% @organisation.tarif_types.each do |tarif_type| %>
          <tr>
            <td><%= link_to tarif_type.nom, edit_tarif_type_path(tarif_type) %></td>
            <td class="text-right w-full sm:w-1/12 px-2">
              <% if policy(tarif_type).destroy? %>
                <%= button_to tarif_type, method: :delete, 'data-turbo-confirm': 'Êtes-vous bien certain.e ???', class:'btn btn-sm btn-ghost' do %>
                  <%= embedded_svg "icons/delete.svg", class: "w-5 h-5 text-error inline" %>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>
    </div>
    <% if policy(TarifType).new? %>
      <button type="button" onclick="myModalTypeTarif.showModal()" class="btn btn-outline btn-primary">
        <%= embedded_svg "icons/add_circle.svg", class: "w-5 h-5 inline" %> Ajouter un type de tarif
      </button>
    <% end %>
  </div>

</div>
<br />
<%= render layout: 'partials/modal', locals: { id: 'myModalTypeTarif', titre: 'Nouveau type de tarif' } do %>
  <%= render 'tarif_types/form', tarif_type: TarifType.new(organisation_id: @organisation.id) %>
<% end %>

<%= render layout: 'partials/modal', locals: { id: 'myModalTypePresta', titre: 'Nouveau type de prestation' } do %>
  <%= render 'prestation_types/form', prestation_type: PrestationType.new(organisation_id: @organisation.id) %>
<% end %>

<%= render layout: 'partials/modal', locals: { id: 'myModalTarif', titre: 'Nouveau tarif' } do %>
  <%= render 'tarifs/form', tarif: Tarif.new %>
<% end %>
