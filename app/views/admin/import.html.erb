<div class="pb-2 mt-6 mb-2 border-b border-slate-200">
  <h2 class="font-light"><%= embedded_svg "icons/upload_file.svg", class: "w-5 h-5 inline align-[-2px]" %> Importer données XLS</h2>
</div>

<p>
    <p>
        <h4>Pour importer les données, votre fichier doit être au format Excel 97-2003 (.xls)<br /> et contenir les colonnes suivantes :</h4>
        <%= Compte.xls_headers.join(', ') %>
    </p>

    <p>
        Exemple de fichier : <%= link_to "Fichier.xls", admin_exemple_fichier_import_xls_url %>
    </p>

    <p>
        <i>
            Ne permet que d'importer des données nouvelles. 
            Pour mettre à jour des données existantes, supprimer l'enregistrement pour qu'il soit recréé avec les nouvelles données.
        </i>
    </p>
</p>

<%= form_with(url: "import_do", method: :post, local: true) do |form| %>

    <div class="w-full sm:w-6/12">
        <fieldset class="fieldset">
          <%= form.label :file, 'Fichier à importer', class: "fieldset-legend" %>
          <%= form.file_field :file, accept: '.xls', required: true, class: "file-input w-full" %>
        </fieldset>
        <fieldset class="fieldset">
          <%= form.label :enregistrer, class: "label" do %>
            <%= form.check_box :enregistrer, class: "checkbox checkbox-primary" %>
            Enregistrer les changements ? (non=Visualisation seulement)
          <% end %>
        </fieldset>  
    </div>
    <br />

    <%= form.submit "Importer", class: "btn btn-outline btn-success", 'data-turbo': false %>
<% end %>

<script type="text/javascript">
    // Workaround for displaying selected file
    $("input[type=file]").change(function () {
        var fieldVal = $(this).val();

        // Change the node's value by removing the fake path (Chrome)
        fieldVal = fieldVal.replace("C:\\fakepath\\", "");

        if (fieldVal != undefined || fieldVal != "") {
            $(this).next(".custom-file-label").attr('data-content', fieldVal);
            $(this).next(".custom-file-label").text(fieldVal);
        }
    });
</script>
