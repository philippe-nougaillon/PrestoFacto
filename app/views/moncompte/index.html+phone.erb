<div class="container mx-auto">
  <div class="flex flex-wrap -mx-2 mb-4 gap-3">
    <div class="flex-1 px-2 pf-btn border border-primary rounded-lg gap-3 shadow-sm p-2">
      <%= link_to moncompte_enfants_path, data: { turbo_frame: "main_frame" }, class:'no-underline text-slate-500' do %>
        <div class="flex-1 px-2 container mx-auto gap-2">
          <div class="flex flex-wrap -mx-2">
            <div class="flex-1 px-2 px-0 text-center">
              <%= embedded_svg "icons/accessibility_new.svg", class: "w-8 h-8 text-primary inline" %>
            </div>
            <div class="w-9/12 px-2 px-0 my-auto">
              <p class="mb-0"><%= "Enfant".pluralize(@enfants_count) %> (<%= @enfants_count %>)</p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="flex-1 px-2 pf-btn border border-success rounded-lg gap-3 shadow-sm p-2">
      <%= link_to moncompte_contacts_path, data: { turbo_frame: "main_frame" }, class:'no-underline text-slate-500' do %>
        <div class="flex-1 px-2 container mx-auto gap-2">
          <div class="flex flex-wrap -mx-2">
            <div class="flex-1 px-2 px-0 text-center">
              <%= embedded_svg "icons/call.svg", class: "w-8 h-8 text-success inline" %>
            </div>
            <div class="w-9/12 px-2 px-0 my-auto">
              <p class="mb-0 flex-1"><%= "Contact".pluralize(@contacts_count) %> (<%= @contacts_count %>)</p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  <div class="flex flex-wrap -mx-2 mb-4 gap-3">
    <div class="flex-1 px-2 pf-btn border border-warning rounded-lg gap-3 shadow-sm p-2">
      <%= link_to moncompte_reservations_path, data: { turbo_frame: "main_frame" }, class:'no-underline text-slate-500' do %>
        <div class="flex-1 px-2 container mx-auto gap-2">
          <div class="flex flex-wrap -mx-2">
            <div class="flex-1 px-2 px-0 text-center">
              <%= embedded_svg "icons/calendar_month.svg", class: "w-8 h-8 text-warning inline" %>
            </div>
            <div class="w-9/12 px-2 px-0 my-auto">
              <p class="mb-0">Réservations</p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="flex-1 px-2 pf-btn border border-error rounded-lg gap-3 shadow-sm p-2">
      <div class="flex-1 px-2 container mx-auto gap-2">
        <%= link_to moncompte_absences_path, data: { turbo_frame: "main_frame" }, class:'no-underline text-slate-500' do %>
          <div class="flex flex-wrap -mx-2">
            <div class="flex-1 px-2 px-0 text-center">
              <%= embedded_svg "icons/event_busy.svg", class: "w-8 h-8 text-error inline" %>
            </div>
            <div class="w-9/12 px-2 px-0 my-auto">
              <p class="mb-0"><%= "Absence".pluralize(@absences_count) %> (<%= @absences_count %>)</p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  <div class="flex flex-wrap -mx-2 mb-4 gap-3">
    <div class="flex-1 px-2 pf-btn border border-info rounded-lg gap-3 shadow-sm p-2">
      <div class="flex-1 px-2 container mx-auto gap-2">
        <%= link_to moncompte_factures_path, data: { turbo_frame: "main_frame" }, class:'no-underline text-slate-500' do %>
          <div class="flex flex-wrap -mx-2">
            <div class="flex-1 px-2 px-0 text-center">
              <%= embedded_svg "icons/description.svg", class: "w-8 h-8 text-info inline" %>
            </div>
            <div class="w-9/12 px-2 px-0 my-auto">
              <p class="mb-0"><%= "Facture".pluralize(@factures_count) %> (<%= @factures_count %>)</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    <div class="flex-1 px-2 pf-btn border border-slate-200 border-muted rounded-lg gap-3 shadow-sm p-2">
      <div class="flex-1 px-2 container mx-auto gap-2">
        <%= link_to moncompte_releve_compte_path, data: { turbo_frame: "main_frame" }, class:'no-underline text-slate-500' do %>
          <div class="flex flex-wrap -mx-2">
            <div class="flex-1 px-2 px-0 text-center">
              <%= embedded_svg "icons/euro_symbol.svg", class: "w-8 h-8 text-slate-500 inline" %>
            </div>
            <div class="w-9/12 px-2 px-0 my-auto">
              <p class="mb-0">
                <span class="<%= 'text-error' if @solde.negative? %>">
                  <%= number_to_currency(@solde, unit: '€', precision: 2, format: "%n %u") %>
                </span>
              </p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= turbo_frame_tag "main_frame" do %>
  <p class="text-4xl text-center mt-12">Bienvenue !</p>
<% end %>