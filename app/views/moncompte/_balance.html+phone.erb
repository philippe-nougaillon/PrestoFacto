<div class="container mx-auto gap-2">
    <div class="flex flex-wrap -mx-2">
        <div class="w-3/12 px-2"><%= l ligne[:date], format: :short %></div>
        <% if ligne[:type] == "Facture" %>
            <div class="flex-1 px-2">Facture <%= ligne[:ref] %></div>
            <div class="w-3/12 px-2 text-right">-<%= number_to_currency(ligne[:mnt], unit:'€') %></div>
        <% else %>
            <div class="flex-1 px-2"><%= ligne[:ref] %></div>
            <div class="w-3/12 px-2 text-right"><%= number_to_currency(ligne[:mnt], unit:'€') %></div>
        <% end %>
    </div>
</div>
<hr>
