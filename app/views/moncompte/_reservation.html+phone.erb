<div class="container mx-auto gap-2">
  <div class="flex flex-wrap -mx-2">
    <%= l reservation.début %>
    au <%= l reservation.fin %>
    <%= reservation.prestation_type.nom %>
    <%# enfant.nom %>
    <%# time_ago_in_words(enfant.date_naissance) if enfant.date_naissance %>
  </div>
  <div class="flex flex-wrap -mx-2">
    <%# enfant.classroom.nom %>
    <%# "Végétarien" if enfant.menu_vege %>
    <%# "Sans porc" if enfant.menu_sp %>
    <%# "Allergie" if enfant.menu_all %>
    <%# enfant.allergenes %>
  </div>
</div>
<hr>