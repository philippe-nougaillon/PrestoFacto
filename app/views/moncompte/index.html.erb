<div class="card mb-12 border border-slate-200">
  <div class="card-title px-6 pt-5 border-b border-slate-200">
    <h2 class="font-light"><%= embedded_svg "icons/person.svg", class: "w-5 h-5 inline align-[-3px]" %> <%= @compte.nom %></h2>
  </div>

  <div class="card-body">
    <%= render partial: 'comptes/compte-card' %>

    <div class="card mt-4 border border-slate-200">
      <div class="card-body">
        <h3><%= embedded_svg "icons/accessibility_new.svg", class: "w-5 h-5 text-primary inline align-[-2px]" %> Enfants</h3>
        <div class="overflow-x-auto">
          <table class="table border border-slate-200 [&_th]:border [&_td]:border table-sm">
            <thead>
              <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Date naissance</th>
                <th>Classe</th>
                <th>Menu Végé?</th>
                <th>Menu SP?</th>
                <th>Menu ALLERGIE?</th>
                <th colspan="3"></th>
              </tr>
            </thead>

            <% @compte.enfants.each do |enfant| %>
              <tr class="row-hover">
                <td><%= enfant.nom %></td>
                <td><%= enfant.prénom %></td>
                <td><%= l(enfant.date_naissance) if enfant.date_naissance %></td>
                <td><%= enfant.classroom.nom %></td>
                <td class="text-center"><%= embedded_svg "icons/check.svg", class: "w-5 h-5 inline" if enfant.menu_vege %></i></td>
                <td class="text-center"><%= embedded_svg "icons/check.svg", class: "w-5 h-5 inline" if enfant.menu_sp %></i></td>
                <td class="text-center"><%= embedded_svg "icons/check.svg", class: "w-5 h-5 inline" if enfant.menu_all %></i></td>
                <td>
                  <% if policy(enfant).edit? %>
                    <%= link_to edit_enfant_path(enfant) do %>
                      <%= embedded_svg "icons/edit.svg", class: "w-5 h-5 inline" %>
                    <% end %>
                  <% end %>
                </td>
                <td>
                  <% if policy(enfant).destroy? %>
                    <%= button_to enfant, method: :delete, 'data-turbo-confirm': 'Êtes-vous bien certain.e ???', class:'btn btn-sm btn-ghost' do %>
                        <%= embedded_svg "icons/delete.svg", class: "w-5 h-5 text-error inline" %>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>

          </table>
        </div>
      </div>
    </div>
  

    <div class="card border border-slate-200">
      <div class="card-body">
        <h3><%= embedded_svg "icons/calendar_month.svg", class: "w-5 h-5 text-warning inline align-[-2px]" %> Réservations</h3>

        <% if @compte.reservations.any? %>
          <div class="overflow-x-auto">
            <table class="table border border-slate-200 [&_th]:border [&_td]:border table-sm">
              <thead>
                <tr>
                  <th>Structure</th>
                  <th>Classe</th>
                  <th>Enfant</th>
                  <th>ALG?</th>
                  <th>Végé?</th>
                  <th>SP?</th>
                  <th>Prestation</th>
                  <th>Début</th>
                  <th>Fin</th>
                  <th>Etat</th>
                  <th>Lun</th>
                  <th>Mar</th>
                  <th>Mer</th>
                  <th>Jeu</th>
                  <th>Ven</th>
                  <th>Matin</th>
                  <th>Midi</th>
                  <th>Soir</th>
                  <th>HScol?</th>
                </tr>
              </thead>

              <tbody>
                <%= render @compte.reservations.includes(:enfant) %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p>
            Aucune réservation pour l'instant...
          </p>
        <% end %>
      </div>

      <div class="card-actions px-6 pb-5 border-t border-slate-200 pt-5">
        <button type="button" onclick="myModalTarif.showModal()" class="btn btn-outline btn-primary">
          <%= embedded_svg "icons/add_circle.svg", class: "w-5 h-5 inline" %> Ajouter une réservation
        </button>
      </div>
    </div>

    <div class="card border border-slate-200">
      <div class="card-body">
        <h3><%= embedded_svg "icons/balance.svg", class: "w-5 h-5 inline align-[-3px]" %> Relevé de compte</h3>

        <div class="overflow-x-auto">
          <table class="table border border-slate-200 [&_th]:border [&_td]:border table-sm">
            <thead>
              <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Référence</th>
                <th class="text-right">Débit</th>
                <th class="text-right">Crédit</th>
                <th class="text-right">Solde</th>
              </tr>
            </thead>

            <tbody>
              <% @releve.each do |ligne| %>
                <%= render partial: 'comptes/balance', locals: {ligne: ligne} %>
              <% end %>
            </tbody>

            <tfoot>
              <tr>
                <th><%= l Date.today %></th>
                <th>SOLDE</th>
                <th></th>
                <th class="text-right"><%= number_to_currency(@debit, unit:'€') %></th>
                <th class="text-right"><%= number_to_currency(@credit, unit:'€') %></th>
                <th class="text-right"><%= number_to_currency(@solde, unit:'€') %></th>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
      <div class="card-actions px-6 pb-5 border-t border-slate-200 pt-5">
        <% if policy(Paiement).new? %>
          <%= link_to new_paiement_path, class: 'btn btn-outline btn-primary' do %>
            <%= embedded_svg "icons/add_circle.svg", class: "w-5 h-5 inline" %> Effectuer un paiement
          <% end %>
        <% end %>
      </div>
    </div>

    <%= render layout: 'partials/modal', locals: { id: 'myModalNewPaiement', titre: 'Nouveau paiement' } do %>
      <%= render 'paiements/form', paiement: Paiement.new(compte_id: @compte.id) %>
    <% end %>
    </div>
    <br>

    <%= render layout: 'partials/modal', locals: { id: 'myModalTarif', titre: 'Nouvelle réservation' } do %>
      <%= render 'reservation', reservation: @compte.reservations.new %>
    <% end %>
    </div>
  </div>
</div>