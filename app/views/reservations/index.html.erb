<div class="flex items-center pb-6 mt-6 mb-2">
  <h2 class="font-light inline mb-0 whitespace-nowrap">
    <%= mi_icon 'calendar-alt', class: 'text-warning' %> 
    Réservations
    <% unless params[:date] == 'full' || params[:date].blank? %>
      du <%= l params[:date].to_date %>
    <% end %>
  </h2>
  <%= link_to guide_path(anchor: "reservations") do %>
    <%= mi_icon 'question-circle', type: :regular, title: "Ouvrir l'aide", class: 'text-slate-400 mx-4 text-2xl' %>
  <% end %>
</div>

<%= form_with url: reservations_path, method: :get do |f| %>
  <div class="flex flex-wrap -mx-2 items-center mb-6 p-4 mx-0 shadow-sm">
    <div class="w-full sm:w-2/12 px-2"><%= f.date_field :date, value: params[:date], onchange: "this.form.submit()" %></div>
    <div class="w-full sm:w-2/12 px-2"><%= f.text_field :nom, value: params[:nom], onchange: "this.form.submit()", label: 'Nom/Prénom', autofocus: false  %></div>
    <div class="w-full sm:w-2/12 px-2"><%= f.select :structure_id, options_from_collection_for_select(@structures, 'id', 'nom', params[:structure_id]), { include_blank: true, label: "Structure" }, { class: "selectpicker", onchange: "this.form.submit()" } %></div>
    <div class="w-full sm:w-2/12 px-2"><%= f.select :classroom_id, options_from_collection_for_select(@classrooms, 'id', 'nom', params[:classroom_id]), { include_blank: true, label: "Classe" }, { class: "selectpicker", onchange: "this.form.submit()" } %></div>
    <div class="w-full sm:w-2/12 px-2"><%= f.select :state, options_for_select(Reservation.workflow_spec.states.keys.to_a, params[:state]), { include_blank: true, label: 'État' }, { onchange: "this.form.submit()" } %></div>
    <div class="w-full sm:w-2/12 px-2"><%= f.select :prestation_type_id, options_from_collection_for_select(@prestation_types, 'id', 'nom', params[:prestation_type_id]), { include_blank: true, label: "Prestation" }, { class: "selectpicker", onchange: "this.form.submit()" } %></div>
  </div>
<% end %>

<%= form_with url: action_reservations_path, method: :post do %>
  <div data-controller="action">
    <div class="overflow-x-auto">
      <table class="table border border-slate-200 shadow-sm">
        <thead>
          <tr>
            <th></th>
            <th><%= sort_link 'structures.nom', 'Structure' %></th>
            <th><%= sort_link 'classrooms.nom', 'Classe' %></th>
            <th><%= sort_link 'enfants.nom', 'Enfant' %></th>
            <th><%= sort_link 'enfants.menu_all', 'ALG?' %></th>
            <th><%= sort_link 'enfants.menu_vege', 'Végé?' %></th>
            <th><%= sort_link 'enfants.menu_sp', 'SP?' %></th>
            <th><%= sort_link 'enfants.mémo', 'Mémo' %></th>
            <th><%= sort_link 'reservations.prestation_type_id', 'Prestation' %></th>
            <th><%= sort_link 'reservations.début', 'Début' %></th>
            <th><%= sort_link 'reservations.fin', 'Fin' %></th>
            <th><%= sort_link 'reservations.workflow_state', 'Etat' %></th>
            <th><%= sort_link 'reservations.lundi', 'Lun' %></th>
            <th><%= sort_link 'reservations.mardi', 'Mar' %></th>
            <th><%= sort_link 'reservations.mercredi', 'Mer' %></th>
            <th><%= sort_link 'reservations.jeudi', 'Jeu' %></th>
            <th><%= sort_link 'reservations.vendredi', 'Ven' %></th>
            <th><%= sort_link 'reservations.samedi', 'Sam' %></th>
            <th><%= sort_link 'reservations.dimanche', 'Dim' %></th>
            <th><%= sort_link 'reservations.matin', 'Matin' %></th>
            <th><%= sort_link 'reservations.midi', 'Midi' %></th>
            <th><%= sort_link 'reservations.soir', 'Soir' %></th>
            <th><%= sort_link 'reservations.hors_période_scolaire', 'HScol?' %></th>
          </tr>
        </thead>

        <tbody>
          <%= render @reservations.includes(:enfant) %>
        </tbody>

        <tfoot>
          <tr>
            <th colspan=4 class="text-right">
              Total :
            </th>
            <th class="text-center">
              <%= @total_alg %>
            </th>
            <th class="text-center">
              <%= @total_vege %>
            </th>
            <th class="text-center">
              <%= @total_sp %>
            </th>
            <th colspan=17></th>
          </tr>
        </tfoot>

      </table>

    </div>
    <div class="flex flex-wrap -mx-2">
      <div class="w-full sm:w-4/12 px-2">
        <div class="join">
          <%= select_tag :action_name, 
                          options_for_select(["Supprimer"]), 
                          include_blank: true, 
                          class: 'select select-bordered select-sm join-item w-full',
                          data: { 'action-target': 'selector' } %>
            <%= submit_tag 'ok',  name: 'action', 
                                  class: 'btn btn-sm btn-outline btn-success join-item',
                                  data: {'action-target': 'button'} %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<div class="mt-2">
  <%= page_entries_info @reservations, entry_name: 'réservation' %>
  <%= paginate @reservations %>

  <% unless params[:date] == 'full' %>
    | <%= link_to "Voir toutes les réservations", reservations_path(date: 'full') %>
  <% end %>
</div>