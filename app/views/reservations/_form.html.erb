<%= form_with(model: reservation, local: true) do |form| %>

  <p>
    <h2>
      <%= @reservation.try(:enfant).try(:nom_et_prénom) %>
    </h2>
  </p>

  <%= form.hidden_field :enfant_id %>
  <fieldset class="fieldset">
    <%= form.label :prestation_type_id, "Prestation type:", class: "fieldset-legend" %>
    <%= form.select :prestation_type_id, options_from_collection_for_select(@prestation_types, 'id', 'nom', reservation.prestation_type_id), {}, { class: "select w-full" } %>
  </fieldset>
  <fieldset class="fieldset">
    <%= form.label :début, class: "fieldset-legend" %>
    <%= form.text_field :début, type: 'date', class: "input w-full" %>
  </fieldset>
  <fieldset class="fieldset">
    <%= form.label :fin, class: "fieldset-legend" %>
    <%= form.text_field :fin, type: 'date', class: "input w-full" %>
  </fieldset>
  
  <div class="flex flex-wrap -mx-2">
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= form.label :lundi, class: "fieldset-legend" %>
        <%= form.text_field :lundi, class: "input w-full" %>
      </fieldset>
    </div>
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= form.label :mardi, class: "fieldset-legend" %>
        <%= form.text_field :mardi, class: "input w-full" %>
      </fieldset>
    </div>
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= form.label :mercredi, class: "fieldset-legend" %>
        <%= form.text_field :mercredi, class: "input w-full" %>
      </fieldset>
    </div>
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= form.label :jeudi, class: "fieldset-legend" %>
        <%= form.text_field :jeudi, class: "input w-full" %>
      </fieldset>
    </div>
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= form.label :vendredi, class: "fieldset-legend" %>
        <%= form.text_field :vendredi, class: "input w-full" %>
      </fieldset>
    </div>
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= form.label :samedi, class: "fieldset-legend" %>
        <%= form.text_field :samedi, class: "input w-full" %>
      </fieldset>
    </div>
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= form.label :dimanche, class: "fieldset-legend" %>
        <%= form.text_field :dimanche, class: "input w-full" %>
      </fieldset>
    </div>
  </div>

  <fieldset class="fieldset">
    <%= form.label :matin, class: "label" do %>
      <%= form.check_box :matin, class: "checkbox checkbox-primary" %>
      Matin
    <% end %>
  </fieldset>
  <fieldset class="fieldset">
    <%= form.label :midi, class: "label" do %>
      <%= form.check_box :midi, class: "checkbox checkbox-primary" %>
      Midi
    <% end %>
  </fieldset>
  <fieldset class="fieldset">
    <%= form.label :soir, class: "label" do %>
      <%= form.check_box :soir, class: "checkbox checkbox-primary" %>
      Soir
    <% end %>
  </fieldset>
  <br />
  <fieldset class="fieldset">
    <%= form.label :workflow_state, 'Etat', class: "fieldset-legend" %>
    <%= form.select :workflow_state, Reservation.workflow_spec.states, {}, { class: "select w-full" } %>
  </fieldset>
  <fieldset class="fieldset">
    <%= form.label :active, class: "label" do %>
      <%= form.check_box :active, class: "checkbox checkbox-primary" %>
      Active
    <% end %>
  </fieldset>
  <br />

  <%= form.submit "Enregistrer", class: "btn btn-outline btn-success" %>

<% end %>
