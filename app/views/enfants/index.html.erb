<div class="flex items-center pb-6 mt-6 mb-2">
  <h2 class="font-light inline mb-0 whitespace-nowrap">
    <%= mi_icon 'child', class: 'text-primary' %>
    Enfants
  </h2>
  <%= link_to guide_path(anchor: "ajout_enfant") do %>
    <%= mi_icon 'question-circle', type: :regular, title: "Ouvrir l'aide", class: 'text-slate-400 mx-4 text-2xl' %>
  <% end %>
</div>

<%= form_with url: enfants_path, method: :get do |f| %>
  <div class="flex flex-wrap -mx-2 items-center mb-6 p-4 mx-0 shadow-sm">
    <div class="flex-1 px-2"><%= f.text_field :search, value: params[:search], label: 'Nom/Prénom/Badge', onchange: "this.form.submit()", autofocus: false %></div>
    <div class="w-full sm:w-3/12 px-2"><%= f.select :structure_id, options_from_collection_for_select(@structures, 'id', 'nom', params[:structure_id]), { include_blank: true, label: "Structure" }, { class: "selectpicker", onchange: "this.form.submit()" } %></div>
    <div class="w-full sm:w-2/12 px-2"><%= f.select :classroom_id, options_from_collection_for_select(@classrooms, 'id', 'nom', params[:classroom_id]), { include_blank: true, label: "Classe" }, { class: "selectpicker", onchange: "this.form.submit()" } %></div>
  </div>
<% end %>

<%= form_with url: action_enfants_path, method: :post do %>
  <div data-controller="action">
    <div class="overflow-x-auto">
      <table class="table border border-slate-200 shadow-sm">
        <thead>
          <tr style="vertical-align: middle;">
            <th></th>
            <th><%= sort_link 'structures.nom', 'Structure' %></th>
            <th><%= sort_link 'classrooms.nom', 'Classe' %></th>
            <th><%= sort_link 'comptes.nom', 'Compte' %></th>
            <th><%= sort_link 'enfants.nom', 'Nom' %></th>
            <th><%= sort_link 'enfants.prénom', 'Prénom' %></th>
            <th><%= sort_link 'enfants.date_naissance', 'Né(e) le' %></th>
            <th><%= sort_link 'enfants.menu_all', 'ALLERGIE?' %></th>
            <th><%= sort_link 'enfants.menu_vege', 'Végé?' %></th>
            <th><%= sort_link 'enfants.menu_sp', 'SP?' %></th>
            <th><%= sort_link 'enfants.mémo', 'Mémo' %></th>
            <th><small class="font-bold text-slate-800">Réservations</small></th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <%= render @enfants.includes(:compte, :classroom) %>
        </tbody>
      </table>

    </div>
    <div class="flex flex-wrap -mx-2">
      <div class="w-full sm:w-4/12 px-2">
        <div class="join">
          <%= select_tag :action_name, 
                          options_for_select(["Marquer comme absent ce jour", "Changer de classe"]), 
                          include_blank: true, 
                          class: 'select select-bordered select-sm join-item w-full',
                          data: { 'action-target': 'selector' } %>
            <%= submit_tag 'ok',  name: 'action', 
                                  class: 'btn btn-sm btn-outline btn-success join-item',
                                  data: {'action-target': 'button'} %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<div class="mt-2">
  <%= page_entries_info @enfants, entry_name: 'enfant' %>
  <%= paginate @enfants %>

  <% if policy(Enfant).to_xls? && !@enfants.size.zero? %>
    <%= link_to url_for(params.permit(:search).merge(format: :xls)),
                class: "inline-flex items-center sm:float-right text-success no-underline hover:underline" do %>
        <%= mi_icon "file-excel", class: 'mr-1' %> Export XLS
    <% end %>
  <% end %>
</div>