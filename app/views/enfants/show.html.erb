<div class="card my-4 border border-slate-200">
  <div class="card-title px-6 pt-5 border-b border-slate-200">
    <h2 class="p-2">
      <%= embedded_svg "icons/accessibility_new.svg", class: "w-5 h-5 text-primary inline align-[-2px]" %>
      <%= @enfant.prénom %>
      <%= @enfant.nom %>
    </h2>
  </div>

  <div class="card-body">
    <div class="flex flex-wrap -mx-2">
      <div class="flex-1 px-2">
        <p>
          <strong>Compte :</strong>
          <%= link_to @enfant.compte.nom, @enfant.compte %>
        </p>

        <p>
          <strong>Classe :</strong>
          <%= @enfant.classroom.nom %>
        </p>

        <p>
          <strong>Badge :</strong>
          <%= @enfant.badge %>
        </p>
      </div>

      <div class="flex-1 px-2">
        <p>
          <strong>Date naissance :</strong>
          <%= l(@enfant.date_naissance) if @enfant.date_naissance %>
        </p>

        <p class="px-4 py-3 <%= 'alert alert-info' unless @enfant.mémo.blank? %>" >
          <%= @enfant.mémo %>
        </p>
      </div>

      <div class="flex-1 px-2">
        <p>
          <strong>Menu 'Végé' ? :</strong>
          <%= "OUI" if @enfant.menu_vege %>
        </p>
        <p>
          <strong>Menu 'Sans porc' ? :</strong>
          <%= "OUI" if @enfant.menu_sp %>
        </p>

        <p class="px-4 py-3 <%= 'alert alert-warning' if @enfant.menu_all %>" >
          <strong>Allergie ? :</strong>
          <%= "OUI" if @enfant.menu_all %>
          <%= "=> #{ @enfant.allergenes }" if @enfant.menu_all %>
        </p>
      </div>

    </div>

    <div class="flex justify-between">
      <% if policy(@enfant).edit? %>
        <%= link_to edit_enfant_path(@enfant), class: "btn btn-outline btn-primary" do %>
          <%= embedded_svg "icons/edit.svg", class: "w-5 h-5 inline" %> Éditer 
        <% end %>
      <% end %>

      <% if policy(@enfant).destroy? %>
        <%= button_to @enfant, method: :delete, 'data-turbo-confirm': 'Attention ! Les réservations, absences et prestations de cet enfant vont être détruites !! Êtes-vous bien certain.e de vouloir faire ça ?', class: 'btn btn-outline btn-error' do %>
          <%= embedded_svg "icons/delete.svg", class: "w-5 h-5 inline" %>
        <% end %>
      <% end %>
    </div>
  

    <div class="card mt-4 border border-slate-200">
      <div class="card-body">
        <h4><%= embedded_svg "icons/calendar_month.svg", class: "w-5 h-5 text-warning inline align-[-2px]" %> Réservations</h4>
        <br>

        <div class="overflow-x-auto">
          <table class="table border border-slate-200 [&_th]:border [&_td]:border table-sm">
            <thead>
              <tr>
                <th>Prestation</th>
                <th>Début</th>
                <th>Fin</th>
                <th>Etat</th>
                <th>Lun</th>
                <th>Mar</th>
                <th>Mer</th>
                <th>Jeu</th>
                <th>Ven</th>
                <th>Sam</th>
                <th>Dim</th>
                <th>Matin</th>
                <th>Midi</th>
                <th>Soir</th>
                <th>HPS?</th>
              </tr>
            </thead>

            <% @enfant.reservations.actives.each do |reservation| %>
              <tr class="row-hover">
                <td><%= reservation.prestation_type.nom %>
                <td><%= l reservation.début %></td>
                <td><%= l reservation.fin %></td>

                <td><span class="badge <%= reservation.style %>"><%= reservation.workflow_state.humanize %></span></td>

                <td class="text-center"><%= number_with_precision(reservation.lundi, locale: :fr, precision: 2, significant: true, strip_insignificant_zeros: true) if reservation.lundi > 0 %></td>
                <td class="text-center"><%= number_with_precision(reservation.mardi, locale: :fr, precision: 2, significant: true, strip_insignificant_zeros: true) if reservation.mardi > 0 %></td>
                <td class="text-center"><%= number_with_precision(reservation.mercredi, locale: :fr, precision: 2, significant: true, strip_insignificant_zeros: true) if reservation.mercredi > 0 %></td>
                <td class="text-center"><%= number_with_precision(reservation.jeudi, locale: :fr, precision: 2, significant: true, strip_insignificant_zeros: true) if reservation.jeudi > 0 %></td>
                <td class="text-center"><%= number_with_precision(reservation.vendredi, locale: :fr, precision: 2, significant: true, strip_insignificant_zeros: true) if reservation.vendredi > 0 %></td>
                <td class="text-center"><%= number_with_precision(reservation.samedi, locale: :fr, precision: 2, significant: true, strip_insignificant_zeros: true) if reservation.samedi > 0 %></td>
                <td class="text-center"><%= number_with_precision(reservation.dimanche, locale: :fr, precision: 2, significant: true, strip_insignificant_zeros: true) if reservation.dimanche > 0 %></td>

                <td class="text-center"><%= embedded_svg "icons/check.svg", class: "w-5 h-5 inline" if reservation.matin %></i></td>
                <td class="text-center"><%= embedded_svg "icons/check.svg", class: "w-5 h-5 inline" if reservation.midi  %></i></td>
                <td class="text-center"><%= embedded_svg "icons/check.svg", class: "w-5 h-5 inline" if reservation.soir  %></i></td>

                <td class="text-center"><%= embedded_svg "icons/beach_access.svg", class: "w-5 h-5 inline" if reservation.hors_période_scolaire %></i></td>
              </tr>
            <% end %>
          </table>
        </div>

        <% if policy(@enfant).edit? %>
          <%= link_to edit_enfant_path(@enfant), class: "btn btn-outline btn-primary" do %>
            <%= embedded_svg "icons/edit.svg", class: "w-5 h-5 inline" %> Éditer les réservations 
          <% end %>
        <% end %>
      </div>
    </div>


    <div class="card border border-slate-200">
      <div class="card-body">
        <h4><%= embedded_svg "icons/event_busy.svg", class: "w-5 h-5 text-error inline align-[-2px]" %> Absences</h4>
        <br>

        <div class="overflow-x-auto">
          <table class="table border border-slate-200 [&_th]:border [&_td]:border table-sm">
            <thead>
              <tr>
                <th>Début</th>
                <th>Fin</th>
                <th>Matin</th>
                <th>Midi</th>
                <th>Soir</th>
              </tr>
            </thead>

            <% @absences.each do |absence| %>
              <tr class="row-hover">
                <td><%= l absence.début %></td>
                <td><%= l absence.fin %></td>
                <td class="text-center"><%= embedded_svg "icons/check.svg", class: "w-5 h-5 inline" if absence.matin %></i></td>
                <td class="text-center"><%= embedded_svg "icons/check.svg", class: "w-5 h-5 inline" if absence.midi  %></i></td>
                <td class="text-center"><%= embedded_svg "icons/check.svg", class: "w-5 h-5 inline" if absence.soir  %></i></td>
              </tr>
            <% end %>
          </table>
        </div>

        <% if policy(Absence).new? %>
          <button type="button" onclick="myModal.showModal()" class="btn btn-outline btn-primary">
            <%= embedded_svg "icons/add_circle.svg", class: "w-5 h-5 inline" %> Ajouter une absence
          </button>
        <% end %>
        |
        <% if params[:archives] == 'yes' %>
          <%= link_to 'Afficher toutes les absences en cours (non-archivées)', url_for(params.permit.merge(archives: 'no')) %> 
        <% else %>
          <%= link_to 'Afficher les absences archivées', url_for(params.permit.merge(archives: 'yes')) %> 
        <% end %>

      </div>
    </div>

    <%= render layout: 'partials/modal', locals: { id: 'myModal', titre: 'Nouvelle absence' } do %>
      <%= render 'absences/modal_form', absence: Absence.new(enfant_id: @enfant.id) %>
    <% end %>

    <div class="card border border-slate-200">
      <div class="card-body">
        <h4><%= embedded_svg "icons/restaurant.svg", class: "w-5 h-5 text-secondary inline align-[-2px]" %> Prestations à facturer</h4>
        <br>

        <div class="overflow-x-auto">
          <table class="table border border-slate-200 [&_th]:border [&_td]:border table-sm">
            <thead>
              <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Qté</th>
              </tr>
            </thead>

            <% @enfant.prestations.à_facturer.order(:date).each do |prestation| %>
              <tr class="row-hover">
                <td><%= l prestation.date %></td>
                <td><%= prestation.prestation_type.nom %></td>
                <td><%= prestation.qté %></td>
              </tr>
            <% end %>
          </table>
        </div>

        <% if policy(Prestation).new? %>
          <button type="button" onclick="myModalPrestation.showModal()" class="btn btn-outline btn-primary">
            <%= embedded_svg "icons/add_circle.svg", class: "w-5 h-5 inline" %> Ajouter une prestation
          </button>
        <% end %>

      </div>
    </div>

    <%= render layout: 'partials/modal', locals: { id: 'myModalPrestation', titre: 'Nouvelle prestation' } do %>
      <%= render 'prestations/modal_form', prestation: Prestation.new(enfant_id: @enfant.id) %>
    <% end %>

    <br>

  </div>

</div>