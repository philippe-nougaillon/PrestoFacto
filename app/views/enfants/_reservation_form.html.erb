<div class="nested-form-wrapper" data-new-record="<%= f.object.new_record? %>">
  <div class="shadow-sm p-6 mb-6">
    <div class="flex flex-wrap -mx-2">
      <div class="flex-1 px-2">
        <fieldset class="fieldset">
          <%= f.label :prestation_type_id, "Type de prestation", class: "fieldset-legend" %>
          <%= f.select :prestation_type_id, options_from_collection_for_select(@prestation_types, 'id', 'nom', f.object.prestation_type_id), { include_blank: true }, { required: true, class: "select w-full" } %>
        </fieldset>
      </div>
      <div class="w-full sm:w-3/12 px-2">
        <fieldset class="fieldset">
          <%= f.label :début, class: "fieldset-legend" %>
          <%= f.date_field :début, required: true, class: "input w-full" %>
        </fieldset>
      </div>
      <div class="w-full sm:w-3/12 px-2">
        <fieldset class="fieldset">
          <%= f.label :fin, class: "fieldset-legend" %>
          <%= f.date_field :fin, required: true, class: "input w-full" %>
        </fieldset>
      </div>
      <div class="flex-1 px-2">
        <fieldset class="fieldset">
          <%= f.label :workflow_state, 'État', class: "fieldset-legend" %>
          <%= f.select :workflow_state, Reservation.workflow_spec.states, { required: true }, { class: "select w-full" } %>
        </fieldset>
      </div>
    </div>

    <div class="flex flex-wrap -mx-2">
      <div class="flex-1 px-2">
        <fieldset class="fieldset">
          <%= f.label :lundi, class: "fieldset-legend" %>
          <%= f.number_field :lundi, step: :any, label_col: "col-sm-3", control_col: "col-sm-6", class: "input w-full" %>
        </fieldset>
      </div>
      <div class="flex-1 px-2">
        <fieldset class="fieldset">
          <%= f.label :mardi, class: "fieldset-legend" %>
          <%= f.number_field :mardi, step: :any, label_col: "col-sm-3", control_col: "col-sm-6", class: "input w-full" %>
        </fieldset>
      </div>
      <div class="flex-1 px-2">
        <fieldset class="fieldset">
          <%= f.label :mercredi, class: "fieldset-legend" %>
          <%= f.number_field :mercredi, step: :any, label_col: "col-sm-5", control_col: "col-sm-6", class: "input w-full" %>
        </fieldset>
      </div>
      <div class="flex-1 px-2">
        <fieldset class="fieldset">
          <%= f.label :jeudi, class: "fieldset-legend" %>
          <%= f.number_field :jeudi, step: :any, label_col: "col-sm-3", control_col: "col-sm-6", class: "input w-full" %>
        </fieldset>
      </div>
      <div class="flex-1 px-2">
        <fieldset class="fieldset">
          <%= f.label :vendredi, class: "fieldset-legend" %>
          <%= f.number_field :vendredi, step: :any, label_col: "col-sm-5", control_col: "col-sm-6", class: "input w-full" %>
        </fieldset>
      </div>
      <div class="flex-1 px-2">
        <fieldset class="fieldset">
          <%= f.label :samedi, class: "fieldset-legend" %>
          <%= f.number_field :samedi, step: :any, label_col: "col-sm-4", control_col: "col-sm-6", class: "input w-full" %>
        </fieldset>
      </div>
      <div class="flex-1 px-2">
        <fieldset class="fieldset">
          <%= f.label :dimanche, class: "fieldset-legend" %>
          <%= f.number_field :dimanche, step: :any, label_col: "col-sm-5", control_col: "col-sm-6", class: "input w-full" %>
        </fieldset>
      </div>
    </div>

    <div class="flex flex-wrap -mx-2">
      <div class="w-full sm:w-1/12 px-2">
        <fieldset class="fieldset">
          <%= f.label :matin, class: "label" do %>
            <%= f.check_box :matin, class: "checkbox checkbox-primary" %>
            Matin
          <% end %>
        </fieldset>
      </div>
      <div class="w-full sm:w-1/12 px-2">
        <fieldset class="fieldset">
          <%= f.label :midi, class: "label" do %>
            <%= f.check_box :midi, class: "checkbox checkbox-primary" %>
            Midi
          <% end %>
        </fieldset>
      </div>
      <div class="w-full sm:w-1/12 px-2">
        <fieldset class="fieldset">
          <%= f.label :soir, class: "label" do %>
            <%= f.check_box :soir, class: "checkbox checkbox-primary" %>
            Soir
          <% end %>
        </fieldset>
      </div>
      <div class="flex-1 px-2">
        <fieldset class="fieldset">
          <%= f.label :hors_période_scolaire, class: "label" do %>
            <%= f.check_box :hors_période_scolaire, class: "checkbox checkbox-primary" %>
            Hors période scolaire
          <% end %>
        </fieldset>
      </div>
      
      <div class="flex-1 px-2"></div>
      <div class="w-full sm:w-2/12 px-2">
        <fieldset class="fieldset">
          <%= f.label :active, class: "label" do %>
            <%= f.check_box :active, class: "checkbox checkbox-primary" %>
            Active
          <% end %>
        </fieldset>
      </div>

      <div class="w-1/12 px-2"><a type="button" data-action="nested-form#remove"><%= embedded_svg "icons/delete.svg", class: "w-5 h-5 text-error mt-1 inline" %></a></div>
    </div>
  </div>
  <%= f.hidden_field :_destroy %>
</div>