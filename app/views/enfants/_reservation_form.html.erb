<div class="nested-form-wrapper" data-new-record="<%= f.object.new_record? %>">
  <div class="shadow-sm p-6 mb-6">
    <div class="flex flex-wrap -mx-2">
      <div class="flex-1 px-2">
        <%= f.select :prestation_type_id, 
                                    options_from_collection_for_select(@prestation_types, 'id', 'nom', f.object.prestation_type_id),
                                    { label: "Type de prestation", include_blank: true }, 
                                    { class: "selectpicker", required: true } %>
      </div>
      <div class="w-full sm:w-3/12 px-2"><%= f.date_field :début, required: true %></div>
      <div class="w-full sm:w-3/12 px-2"><%= f.date_field :fin, required: true %></div>
      <div class="flex-1 px-2"><%= f.select :workflow_state, Reservation.workflow_spec.states, label: 'État', required: true %></div>
    </div>

    <div class="flex flex-wrap -mx-2">
      <div class="flex-1 px-2"><%= f.number_field :lundi, step: :any, label_col: "col-sm-3", control_col: "col-sm-6" %></div>
      <div class="flex-1 px-2"><%= f.number_field :mardi, step: :any, label_col: "col-sm-3", control_col: "col-sm-6" %></div>
      <div class="flex-1 px-2"><%= f.number_field :mercredi, step: :any, label_col: "col-sm-5", control_col: "col-sm-6" %></div>
      <div class="flex-1 px-2"><%= f.number_field :jeudi, step: :any, label_col: "col-sm-3", control_col: "col-sm-6" %></div>
      <div class="flex-1 px-2"><%= f.number_field :vendredi, step: :any, label_col: "col-sm-5", control_col: "col-sm-6" %></div>
      <div class="flex-1 px-2"><%= f.number_field :samedi, step: :any, label_col: "col-sm-4", control_col: "col-sm-6" %></div>
      <div class="flex-1 px-2"><%= f.number_field :dimanche, step: :any, label_col: "col-sm-5", control_col: "col-sm-6" %></div>
    </div>

    <div class="flex flex-wrap -mx-2">
      <div class="w-full sm:w-1/12 px-2"><%= f.check_box :matin, custom: :switch %></div>
      <div class="w-full sm:w-1/12 px-2"><%= f.check_box :midi, custom: :switch %></div>
      <div class="w-full sm:w-1/12 px-2"><%= f.check_box :soir, custom: :switch %></div>
      <div class="flex-1 px-2"><%= f.check_box :hors_période_scolaire, custom: :switch %></div>
      
      <div class="flex-1 px-2"></div>
      <div class="w-full sm:w-2/12 px-2"><%= f.check_box :active, custom: :switch %></div>

      <div class="w-1/12 px-2"><a type="button" data-action="nested-form#remove"><%= mi_icon 'trash-alt', class:"text-error mt-1" %></a></div>
    </div>
  </div>
  <%= f.hidden_field :_destroy %>
</div>