<h2 class="mb-6">Changer de classe</h2>
<h3 class="mb-12 fw-lighter">Choisissez la classe de destination</h3>

<div class="flex flex-wrap -mx-2">
  <div class="w-full sm:w-4/12 px-2">
    <%= form_with url: action_execute_enfants_path, method: :post do %>
      <%= hidden_field_tag :enfants_id, params[:enfants_id].keys %>
      <%= select_tag :classroom_id,
                        options_from_collection_for_select(
                          current_user.organisation.classrooms,
                          'id',
                          'nom_et_structure',
                          params[:classroom_id]
                        ),
                      class: "select select-bordered w-full mb-4"
      %>
      <%=  submit_tag 'Changer', class: 'btn btn-outline btn-success' %>
      <%= link_to 'Annuler', enfants_path, class: 'btn btn-link'%>
    <% end %>
  </div>
</div>