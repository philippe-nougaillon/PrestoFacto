<%= form_with(model: structure, local: true, data: { controller: 'nested-form', nested_form_wrapper_selector_value: '.nested-form-wrapper' }) do |form| %>

  <%= form.hidden_field :organisation_id %>
  <div class="flex flex-wrap -mx-2">
    <div class="w-full sm:w-6/12 px-2">
      <fieldset class="fieldset">
        <%= form.label :nom, class: "fieldset-legend" %>
        <%= form.text_field :nom, class: "input w-full" %>
      </fieldset>
    </div>
  </div>
  <div class="flex flex-wrap -mx-2">
    <div class="w-full sm:w-4/12 px-2">
      <fieldset class="fieldset">
        <%= form.label :adresse, class: "fieldset-legend" %>
        <%= form.text_field :adresse, class: "input w-full" %>
      </fieldset>
    </div>
    <div class="w-full sm:w-2/12 px-2">
      <fieldset class="fieldset">
        <%= form.label :cp, class: "fieldset-legend" %>
        <%= form.text_field :cp, class: "input w-full" %>
      </fieldset>
    </div>
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= form.label :ville, class: "fieldset-legend" %>
        <%= form.text_field :ville, class: "input w-full" %>
      </fieldset>
    </div>
  </div>
  <hr />

  <h3>Classes</h3>
  <template data-nested-form-target="template">
    <%= form.fields_for :classrooms, Classroom.new, child_index: 'NEW_RECORD' do |classroom_fields| %>
      <%= render "classroom_form", form: classroom_fields %>
    <% end %>
  </template>
  <%= form.fields_for :classrooms do |classroom_fields| %>
    <%= render "classroom_form", form: classroom_fields %>
  <% end %>

  <!-- Inserted elements will be injected before that target. -->
  <div data-nested-form-target="target"></div>

  <button class="btn btn-outline btn-primary" type="button" data-action="nested-form#add"><%= mi_icon 'plus-circle' %> Ajouter classe</button>
  <%= form.submit "Enregistrer", class: "btn btn-outline btn-success" %>
<% end %>
