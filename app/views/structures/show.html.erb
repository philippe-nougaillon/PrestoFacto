<p>
  <h2>
    <%= @structure.nom %>
  </h2>
</p>

<p>
  <strong>Adresse:</strong>
  <%= @structure.adresse %>
</p>

<p>
  <strong>Cp:</strong>
  <%= @structure.cp %>
</p>

<p>
  <strong>Ville:</strong>
  <%= @structure.ville %>
</p>
<br />

<h3>Classes</h3>
<div class="overflow-x-auto">
  <table class="table table-zebra">
    <thead>
      <tr>
        <th>Nom</th>
        <th>Référent</th>
        <th>Enfants</th>
      </tr>
    </thead>

    <% @structure.classrooms.each do |classroom| %>
      <tr class="row-hover">
        <td><%= classroom.nom %></td>
        <td><%= classroom.référent %></td>
        <td><%= classroom.enfants.size %></td>
      </tr>
    <% end %>
  </table>
</div>

<% if policy(@structure).edit? %>
  <%= link_to  edit_structure_path(@structure) do %>
    <%= embedded_svg "icons/edit.svg", class: "w-5 h-5 inline" %> Éditer
  <% end %>
<% end %>