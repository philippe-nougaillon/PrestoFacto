<div class="nested-form-wrapper" data-new-record="<%= form.object.new_record? %>">
  <div class="flex flex-wrap -mx-2">
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= form.label :nom, class: "fieldset-legend" %>
        <%= form.text_field :nom, class: "input w-full" %>
      </fieldset>
    </div>
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= form.label :référent, class: "fieldset-legend" %>
        <%= form.text_field :référent, class: "input w-full" %>
      </fieldset>
    </div>
    <div class="w-1/12 px-2"><a type="button" data-action="nested-form#remove"><%= embedded_svg "icons/delete.svg", class: "w-5 h-5 text-error mt-2 inline" %></a></div>
  </div>
  <%= form.hidden_field :_destroy %>
</div>