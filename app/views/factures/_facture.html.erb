<tr class="row-hover">
    <td style="text-align: center">
        <span data-action="click->action#click">
            <%= check_box_tag "factures_id[#{facture.id}]", 'yes', false, class: "checkbox checkbox-sm checkbox-primary", data: {"action-target": "source", "checkbox-select-all-target": "checkbox"} %>
        </span>
    </td>
    <td><%= link_to facture.réf, facture, style: 'white-space: nowrap;' %></td>
    <td><%= l facture.date.to_date %></td>
    <td><%= link_to facture.compte.nom, facture.compte %></td>
    <td><%= l facture.envoyée_le.to_date if facture.envoyée_le %></td>
    <td class="text-right">
        <%= number_to_currency(facture.montant, unit: '€', precision: 2, format: '%n %u') %>
        <% @total_page += facture.montant %>
    </td>
    <td><%= facture.mémo %></td>
    <td><span class="badge <%= facture.style %>"><%= facture.try(:workflow_state).try(:humanize) %></span></td>
    <td>
        <% if policy(Paiement).new? %>
            <%= link_to new_paiement_path(compte_id: facture.compte_id, réf: facture.réf, montant: facture.montant), target: '_blank', title: "Saisir le paiement de cette facture", class: 'btn btn-sm btn-ghost' do %>
                <%= embedded_svg "icons/payments.svg", class: "w-5 h-5 text-success inline" %>
            <% end %>
        <% end %>
    </td>
    <td>
        <% if policy(facture).show? %>
            <%= link_to facture_url(facture, format: :pdf), target: '_blank', title: "Voir la facture en PDF", class: 'btn btn-sm btn-ghost' do %>
                <%= embedded_svg "icons/picture_as_pdf.svg", class: "w-5 h-5 text-slate-800 inline" %>
            <% end %>
        <% end %>
    </td>
</tr>
