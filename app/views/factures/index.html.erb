<div class="flex items-center pb-6 mt-6 mb-2">
  <h2 class="font-light inline mb-0 whitespace-nowrap">
    <%= mi_icon 'file-invoice', class: 'text-info' %> 
    Factures
  </h2>
  <%= link_to guide_path(anchor: "facturation") do %>
    <%= mi_icon 'question-circle', type: :regular, title: "Ouvrir l'aide", class: 'text-slate-400 mx-4 text-2xl' %>
  <% end %>
</div>

<%= form_with url: factures_path, method: :get do |f| %>
  <div class="flex flex-wrap -mx-2 items-center mb-6 p-4 mx-0 shadow-sm">
    <div class="flex-1 px-2"><%= f.text_field :search, value: params[:search], label:"Nom du compte/Référence facture", onchange: "this.form.submit()", autofocus: false %></div>
    <div class="w-full sm:w-2/12 px-2"><%= f.select :state, options_for_select(Facture.workflow_spec.states.keys.to_a, params[:state]), { include_blank: true, label: 'État' }, { onchange: "this.form.submit()" } %></div>
    <div class="w-full sm:w-2/12 px-2"><%= f.date_field :date_début, value: params[:date_début], onchange: "this.form.submit()" %></div>
    <div class="w-full sm:w-2/12 px-2"><%= f.date_field :date_fin, value: params[:date_fin], onchange: "this.form.submit()" %></div>
  </div>
<%end %>


<%= form_with url: action_factures_path, method: :post, data: { turbo: false } do %>
  <div data-controller="checkbox-select-all action">
    <div class="overflow-x-auto">
      <table class="table border border-slate-200 shadow-sm">
        <thead>
          <tr>
            <th style="text-align: center">
              <span data-action="click->action#click">
                <input type="checkbox" class="checkbox checkbox-sm checkbox-primary" data-checkbox-select-all-target="checkboxAll" data-action-target="source">
              </span>
            </th>
            <th><%= sort_link 'factures.réf', 'Référence' %></th>
            <th><%= sort_link 'factures.date', 'Date' %></th>
            <th><%= sort_link 'comptes.nom', 'Compte' %></th>
            <th><%= sort_link 'factures.envoyée_le', 'Envoyée le' %></th>
            <th><%= sort_link 'factures.montant', 'Montant' %></th>
            <th><%= sort_link 'factures.mémo', 'Mémo' %></th>
            <th><%= sort_link 'factures.workflow_state', 'Etat' %></th>
            <th colspan=2></th>
          </tr>
        </thead>

        <tbody>
          <%= render @factures.includes(:compte) %>
        </tbody>

        <tfoot>
          <tr>
            <td colspan=5 class="text-right">
              Total page :
            </td>
            <td class="text-right">
              <%= number_to_currency(@total_page, unit: '€', precision: 2, format: '%n %u') %>
            </td>
            <th colspan=5></th>
          </tr>
          
          <tr>
            <th colspan=5 class="text-right">
              Total :
            </th>
            <th class="text-right">
              <%= number_to_currency(@total_factures, unit: '€', precision: 2, format: '%n %u') %>
            </th>
            <th colspan=5></th>
          </tr>
        </tfoot>
      </table>


    </div>
    <div class="flex flex-wrap -mx-2">
      <div class="w-full sm:w-3/12 px-2">
        <div class="join">
          <%= select_tag :action_name, 
                          options_for_select(["Passer à l'état 'vérifiée'", "Envoyer", "Télécharger les PDF"]),
                          include_blank: true, 
                          class: 'select select-bordered select-sm join-item w-full',
                          data: { 'action-target': 'selector' } %>
            <%= submit_tag 'Ok',  name: 'action', 
                                  class: 'btn btn-sm btn-outline btn-success join-item',
                                  data: {'action-target': 'button', 'turbo-method': :post} %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<div class="mt-2">
  <%= page_entries_info @factures, entry_name: 'facture' %>
  <%= paginate @factures %>

  <% if policy(Facture).to_xls? && !@factures.size.zero? %>
    <%= link_to url_for(params.permit(:structure_id, :date_début, :date_fin, :search).merge(format: :xls)),
                class: "inline-flex items-center sm:float-right text-success no-underline hover:underline" do %>
      <%= mi_icon "file-excel", class: 'mr-1' %> Export XLS
    <% end %>
  <% end %>
</div>