<%= form_with(model: facture, layout: :horizontal, local: true, data: { controller: 'nested-form', nested_form_wrapper_selector_value: '.nested-form-wrapper' }) do |form| %>

  <% if facture.errors.any? %>
    <div id="error_explanation">
      <h3><%= pluralize(facture.errors.count, "erreur") %> empêche(nt) l'enregistrement de la facture:</h3>

      <ul>
      <% facture.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :compte_id %>

  <div class="flex flex-wrap -mx-2 shadow-sm p-2">

    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= form.label :date, class: "fieldset-legend" %>
        <%= form.date_field :date, class: "input w-full" %>
      </fieldset>
      <fieldset class="fieldset">
        <%= form.label :réf, 'Référence', class: "fieldset-legend" %>
        <%= form.text_field :réf, required: true, class: "input w-full" %>
      </fieldset>
      <fieldset class="fieldset">
        <%= form.label :workflow_state, 'Etat', class: "fieldset-legend" %>
        <%= form.select :workflow_state, Facture.workflow_spec.states, {}, { class: "select w-full" } %>
      </fieldset>
    </div>
    
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= form.label :échéance, 'Echéance', class: "fieldset-legend" %>
        <%= form.date_field :échéance, class: "input w-full" %>
      </fieldset>
      <% unless facture.new_record? %>
        <fieldset class="fieldset">
          <%= form.label :envoyée_le, 'Envoi_le', class: "fieldset-legend" %>
          <%= form.datetime_field :envoyée_le, include_blank: true, class: "input w-full" %>
        </fieldset>
      <% end %>
      <fieldset class="fieldset">
        <%= form.label :mémo, class: "fieldset-legend" %>
        <%= form.text_area :mémo, rows: 4, class: "textarea w-full" %>
      </fieldset>
    </div>

    <% unless facture.new_record? %>
      <div class="w-3/12 px-2">
        <fieldset class="fieldset">
          <%= form.label :montant, 'Total', class: "fieldset-legend" %>
          <%= form.number_field :montant, step: :any, disabled: true, class: "input w-full" %>
        </fieldset>
      </div>
    <% end %>
  </div>

  <h4 class="title is-3 mt-6 p-2">Prestations</h4>

  <template data-nested-form-target="template">
    <%= form.fields_for :facture_lignes, FactureLigne.new, child_index: 'NEW_RECORD' do |facture_ligne_fields| %>
      <%= render "facture_ligne_form", f: facture_ligne_fields %>
    <% end %>
  </template>

  <%= form.fields_for :facture_lignes do |facture_ligne_fields| %>
    <%= render "facture_ligne_form", f: facture_ligne_fields %>
  <% end %>

  <!-- Inserted elements will be injected before that target. -->
  <div data-nested-form-target="target"></div>

  <div class="mb-4">
    <button class="btn btn-outline btn-primary" type="button" data-action="nested-form#add"><%= mi_icon 'plus-circle' %> Ajouter une ligne</button>
    <%= form.submit "Enregistrer", class: "btn btn-outline btn-success" %>
  </div>

<% end %>
