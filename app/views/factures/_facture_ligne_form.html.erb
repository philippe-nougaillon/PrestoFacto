<div class="nested-form-wrapper mb-4" data-new-record="<%= f.object.new_record? %>">
  <div class="flex flex-wrap -mx-2 shadow-sm p-2">
    <div class="flex flex-wrap -mx-2">
      <div class="w-6/12 px-2">
        <fieldset class="fieldset">
          <%= f.label :intitulé, class: "fieldset-legend" %>
          <%= f.text_field :intitulé, placeholder: "Intitulé", required: true, class: "input w-full" %>
        </fieldset>
      </div>
      <div class="flex-1 px-2">
        <fieldset class="fieldset">
          <%= f.label :prestation_type_id, "Type_presta.", class: "fieldset-legend" %>
          <%= f.select :prestation_type_id, options_from_collection_for_select(@prestation_types, 'id', 'nom', f.object.prestation_type_id), {}, { include_blank: true, required: true, class: "select w-full" } %>
        </fieldset>
      </div>
    </div>
    <div class="flex flex-wrap -mx-2">
      <div class="w-6/12 px-2">
        <fieldset class="fieldset">
          <%= f.label :qté, class: "fieldset-legend" %>
          <%= f.number_field :qté, step: :any, class: "input w-full" %>
        </fieldset>
      </div>
      <div class="flex-1 px-2">
        <fieldset class="fieldset">
          <%= f.label :prix, class: "fieldset-legend" %>
          <%= f.number_field :prix, step: :any, class: "input w-full" %>
        </fieldset>
      </div>
      <% unless f.object.new_record? %>
        <div class="flex-1 px-2">
          <fieldset class="fieldset">
            <%= f.label :total, class: "fieldset-legend" %>
            <%= f.number_field :total, disabled: true, class: "input w-full" %>
          </fieldset>
        </div>
      <% end %>
      <div class="w-full sm:w-1/12 px-2"><a type="button" data-action="nested-form#remove"><%= embedded_svg "icons/delete.svg", class: "w-5 h-5 text-error mt-2 inline" %></a></div>
    </div>
  </div>
  <%= f.hidden_field :_destroy %>
</div>