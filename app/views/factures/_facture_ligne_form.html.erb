<div class="nested-form-wrapper mb-4" data-new-record="<%= f.object.new_record? %>">
  <div class="flex flex-wrap -mx-2 shadow-sm p-2">
    <div class="flex flex-wrap -mx-2">
      <div class="w-6/12 px-2"><%= f.text_field :intitulé, placeholder: "Intitulé", required: true %></div>
      <div class="flex-1 px-2"><%= f.select :prestation_type_id, options_from_collection_for_select(@prestation_types, 'id', 'nom', f.object.prestation_type_id), { label: "Type_presta." }, { class: "selectpicker", include_blank: true, required: true } %></div>
    </div>
    <div class="flex flex-wrap -mx-2">
      <div class="w-6/12 px-2"><%= f.number_field :qté, step: :any %></div>
      <div class="flex-1 px-2"><%= f.number_field :prix, step: :any %></div>
      <% unless f.object.new_record? %>
        <div class="flex-1 px-2"><%= f.number_field :total, disabled: true %></div>
      <% end %>
      <div class="w-full sm:w-1/12 px-2"><a type="button" data-action="nested-form#remove"><%= mi_icon 'trash-alt', class:"text-error mt-2" %></a></div>
    </div>
  </div>
  <%= f.hidden_field :_destroy %>
</div>