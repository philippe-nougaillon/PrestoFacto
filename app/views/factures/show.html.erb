<div class="card my-4 border border-slate-200">
  <div class="card-title px-6 pt-5 border-b border-slate-200">
    <h4 class="p-2">  
      <%= embedded_svg "icons/description.svg", class: "w-5 h-5 text-info inline align-[-2px]" %> Facture #<%= @facture.réf %> | <%= @facture.compte.nom %>
    </h4>
  </div>
  <div class="card-body">
    <div class="flex flex-wrap -mx-2">
      <div class="flex-1 px-2">
        <p>
          <strong>Date:</strong>
          <%= l @facture.date.to_date %>
        </p>

        <p>
          <strong>Echéance le:</strong>
          <%= l @facture.échéance.to_date if @facture.échéance %>
        </p>

        <p>
          <strong>Envoyée le:</strong>
          <%= l @facture.envoyée_le if @facture.envoyée_le %>
        </p>

        <p>
          <strong>Vérifiée:</strong>
          <%= embedded_svg "icons/check.svg", class: "w-5 h-5 inline" if @facture.vérifiée %></i>
        </p>
      </div>

      <div class="flex-1 px-2">
        <p>
          <strong>Etat:</strong>
          <span class="badge <%= @facture.style %>"><%= @facture.try(:workflow_state).try(:humanize) %></span>        </p>
        <p>
          <strong>Mémo:</strong>
          <%= @facture.mémo %>
        </p>
      </div>
    </div>
  </div>

  <div class="card-actions px-6 pb-5 flex border-t border-slate-200 pt-5">
    <%= link_to edit_facture_path(@facture), class: "btn btn-ghost" do %>
      <%= embedded_svg "icons/edit.svg", class: "w-5 h-5 inline" %> Éditer
    <% end %>
    <% if policy(@facture).show? %>
        <%= link_to facture_url(@facture, format: :pdf), target: '_blank', class: "btn btn-ghost" do %>
            <%= embedded_svg "icons/picture_as_pdf.svg", class: "w-5 h-5 text-error inline" %> Afficher le PDF
        <% end %>
    <% end %>
    <% if policy(@facture).destroy? %>
      <%= button_to @facture, method: :delete, 'data-turbo-confirm': 'Êtes-vous bien certain.e ???', class: 'btn btn-outline btn-error' do %>
        <%= embedded_svg "icons/delete.svg", class: "w-5 h-5 inline" %>
      <% end %>
    <% end %>
  </div>
</div>
<br>

<div class="overflow-x-auto">
  <table class="table table-zebra border border-slate-200 [&_th]:border [&_td]:border">
    <thead>
      <tr>
        <th>Intitulé</th>
        <th>Prestation</th>
        <th>Qté</th>
        <th>Prix</th>
        <th>Total</th>
      </tr>
    </thead>
    <% @facture.facture_lignes.each do |ligne| %>
      <tr>
        <td><%= ligne.intitulé %></td>
        <td><%= ligne.prestation_type.nom %></td>
        <td class="text-right"><%= ligne.qté %></td>
        <td class="text-right"><%= number_to_currency(ligne.prix, unit: '€', precision: 2, format: "%n %u") %></td>
        <td class="text-right"><%= number_to_currency(ligne.total, unit: '€', precision: 2, format: "%n %u") %></td>
      </tr>
    <% end %>
    <tfoot>
      <tr>
        <td colspan=4></td>
        <td class="text-right">
          <b><%= number_to_currency(@facture.montant, unit: '€', precision: 2, format: "%n %u") %></b>
        </td>
      </tr>
    </tfoot>
  </table>
</div>

