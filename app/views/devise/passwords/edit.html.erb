<%= render layout: "devise/shared/auth_card", locals: { titre: "Changement de mot de passe" } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <%= f.password_field :password, autofocus: false, autocomplete: "new-password",
                         label: "Nouveau mot de passe",
                         help: ("#{@minimum_password_length} caractères minimum" if @minimum_password_length) %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password",
                         label: "Confirmation du mot de passe" %>

    <%= f.submit "Changer mon mot de passe", class: "btn btn-primary text-white w-full" %>
  <% end %>
<% end %>
