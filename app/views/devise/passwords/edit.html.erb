<%= render layout: "devise/shared/auth_card", locals: { titre: "Changement de mot de passe" } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <fieldset class="fieldset">
      <%= f.label :password, "Nouveau mot de passe", class: "fieldset-legend" %>
      <%= f.password_field :password, autofocus: false, autocomplete: "new-password", class: "input w-full" %>
      <p class="label"><%= ("#{@minimum_password_length} caractères minimum" if @minimum_password_length) %></p>
    </fieldset>
    <fieldset class="fieldset">
      <%= f.label :password_confirmation, "Confirmation du mot de passe", class: "fieldset-legend" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input w-full" %>
    </fieldset>

    <%= f.submit "Changer mon mot de passe", class: "btn btn-primary text-white w-full" %>
  <% end %>
<% end %>
