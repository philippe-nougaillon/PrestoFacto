<div class="max-w-xl mx-auto mt-4">
  <div class="card bg-white shadow-sm border border-slate-200">
    <div class="card-body">
      <h1 class="text-2xl font-title font-bold text-primary mb-6">Mon compte</h1>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <fieldset class="fieldset">
          <%= f.label :email, "Adresse email", class: "fieldset-legend" %>
          <%= f.email_field :email, autofocus: false, autocomplete: "email", class: "input w-full" %>
        </fieldset>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p class="text-sm text-warning mb-4">
            En attente de confirmation pour : <%= resource.unconfirmed_email %>
          </p>
        <% end %>

        <fieldset class="fieldset">
          <%= f.label :password, "Nouveau mot de passe", class: "fieldset-legend" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "input w-full" %>
          <p class="label"><%= "Laissez vide pour ne pas le changer#{" (#{@minimum_password_length} caractères minimum)" if @minimum_password_length}" %></p>
        </fieldset>
        <fieldset class="fieldset">
          <%= f.label :password_confirmation, "Confirmation du mot de passe", class: "fieldset-legend" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input w-full" %>
        </fieldset>
        <fieldset class="fieldset">
          <%= f.label :current_password, "Mot de passe actuel", class: "fieldset-legend" %>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "input w-full" %>
          <p class="label">Nécessaire pour confirmer vos changements</p>
        </fieldset>

        <%= f.submit "Mettre à jour", class: "btn btn-primary text-white w-full" %>
      <% end %>

      <div class="mt-6 pt-4 border-t border-slate-200">
        <h2 class="font-semibold text-error mb-2">Supprimer mon compte</h2>
        <%= button_to "Supprimer définitivement mon compte", registration_path(resource_name),
                      method: :delete,
                      class: "btn btn-outline btn-error btn-sm",
                      'data-turbo-confirm': 'Êtes-vous bien certain.e ???' %>
      </div>

      <div class="mt-4 text-sm">
        <%= link_to "Retour", :back, class: "link link-primary" %>
      </div>
    </div>
  </div>
</div>
