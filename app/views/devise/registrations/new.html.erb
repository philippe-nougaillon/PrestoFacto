<div class="max-w-3xl mx-auto mt-4">
  <div class="card bg-white shadow-sm border border-slate-200">
    <div class="card-body">
      <h1 class="text-3xl font-title font-bold text-primary text-center mb-6">Inscription</h1>

      <%- if devise_mapping.omniauthable? %>
        <%- resource_class.omniauth_providers.each do |provider| %>
          <%= form_for "Login",
            url: omniauth_authorize_path(resource_name, provider),
            method: :post,
            data: { turbo: "false" } do |f| %>
            <button type="submit" class="btn btn-outline w-full bg-white border-slate-300 text-slate-700 hover:bg-slate-50 font-normal normal-case">
              <%= image_tag "Google__G__logo.svg", class: "w-5 h-5" %>
              <span>S'inscrire automatiquement avec un compte Google</span>
            </button>
          <% end %>
        <% end %>
        <div class="divider text-slate-400 text-xs">OU</div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%= f.email_field :email, value: params[:email], autofocus: false, required: true,
                          autocomplete: "email", label: "Adresse email" %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <%= f.password_field :password, value: params[:password], required: true,
                               autocomplete: "new-password", label: "Mot de passe",
                               help: ("#{@minimum_password_length} caractères minimum" if @minimum_password_length) %>
          <%= f.password_field :password_confirmation, value: params[:password], required: true,
                               autocomplete: "new-password", label: "Confirmation du mot de passe" %>
        </div>

        <div class="w-full mb-4">
          <%= label_tag :organisation, "Association / Mairie", class: DaisyFormBuilder::LABEL_CLASS %>
          <%= text_field_tag :organisation, params[:organisation], required: true,
                             placeholder: "Le nom de votre ASSOCIATION/MAIRIE",
                             class: "input input-bordered w-full" %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="md:col-span-2">
            <%= label_tag :structure, "Nom de la structure (CANTINE/GARDERIE/...)", class: DaisyFormBuilder::LABEL_CLASS %>
            <%= text_field_tag :structure, (params[:structure] || "Cantine"), required: true,
                               class: "input input-bordered w-full" %>
          </div>
          <div>
            <%= label_tag :zone, "Zone de vacances scolaires", class: DaisyFormBuilder::LABEL_CLASS %>
            <%= select_tag :zone, options_for_select(['A', 'B', 'C'], (params[:zone] || 'A')),
                           class: "select select-bordered w-full" %>
          </div>
        </div>

        <div class="my-4">
          <%= recaptcha_tags unless Rails.env.development? %>
        </div>

        <div data-turbo="false">
          <%= f.submit "S'inscrire", class: "btn btn-primary text-white w-full" %>
        </div>
      <% end %>

      <%# Pas de devise/shared/links : il répéterait le bouton Google du haut de page. %>
      <div class="mt-6 pt-4 border-t border-slate-200 text-sm text-center">
        <%= link_to "Déjà inscrit ? Se connecter", new_session_path(resource_name), class: "link link-primary" %>
      </div>
    </div>
  </div>
</div>
