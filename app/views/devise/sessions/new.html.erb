<div class="max-w-md mx-auto mt-6">
  <div class="card bg-white shadow-sm border border-slate-200">
    <div class="card-body">
      <h1 class="text-3xl font-title font-bold text-primary text-center mb-6">Connexion</h1>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <fieldset class="fieldset">
          <%= f.label :email, "Adresse email", class: "fieldset-legend" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input w-full" %>
        </fieldset>
        <fieldset class="fieldset">
          <%= f.label :password, "Mot de passe", class: "fieldset-legend" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "input w-full" %>
        </fieldset>

        <% if devise_mapping.rememberable? %>
          <fieldset class="fieldset">
            <%= f.label :remember_me, class: "label" do %>
              <%= f.check_box :remember_me, class: "checkbox checkbox-primary" %>
              Se souvenir de moi
            <% end %>
          </fieldset>
        <% end %>

        <%= f.submit "Se connecter", class: "btn btn-primary text-white w-full" %>
      <% end %>

      <div class="mt-6 pt-4 border-t border-slate-200 text-sm text-center">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
