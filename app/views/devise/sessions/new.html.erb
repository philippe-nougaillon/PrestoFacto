<div class="max-w-md mx-auto mt-6">
  <div class="card bg-white shadow-sm border border-slate-200">
    <div class="card-body">
      <h1 class="text-3xl font-title font-bold text-primary text-center mb-6">Connexion</h1>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", label: "Adresse email" %>
        <%= f.password_field :password, autocomplete: "current-password", label: "Mot de passe" %>

        <% if devise_mapping.rememberable? %>
          <%= f.check_box :remember_me, custom: :switch, label: "Se souvenir de moi" %>
        <% end %>

        <%= f.submit "Se connecter", class: "btn btn-primary text-white w-full" %>
      <% end %>

      <div class="mt-6 pt-4 border-t border-slate-200 text-sm text-center">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
