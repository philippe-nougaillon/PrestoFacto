<%= render layout: "devise/shared/auth_card", locals: { titre: "Renvoyer les instructions de déverrouillage" } do %>
  <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.email_field :email, autofocus: false, autocomplete: "email", label: "Adresse email" %>
    <%= f.submit "Renvoyer les instructions", class: "btn btn-primary text-white w-full" %>
  <% end %>
<% end %>
