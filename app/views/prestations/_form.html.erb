<%= form_with(model: prestation, local: true) do |form| %>

    <%= form.hidden_field :enfant_id %>

    <div class="flex flex-wrap -mx-2">
        <div class="w-full sm:w-4/12 px-2">
            <%= form.date_field :date %>
            <%= form.select :prestation_type_id, options_from_collection_for_select(@prestation_types, 'id', 'nom', prestation.prestation_type_id), { label: "Prestation type:", wrapper: { class: 'has-warning', data: { foo: 'bar' } } }, { class: "selectpicker" } %>
            <%= form.number_field :qté, step: :any %>
        </div>
    </div>

    <%= form.submit "Enregistrer", class: "btn btn-outline btn-success" %>

<% end %>
