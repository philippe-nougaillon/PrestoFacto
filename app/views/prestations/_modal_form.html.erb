<%= form_with(url: prestations_path, model: prestation, method: :post, local: true) do |form| %>

    <%= form.hidden_field :enfant_id %>

    <div class="">
        <fieldset class="fieldset">
          <%= form.label :date, 'Date', class: "fieldset-legend" %>
          <%= form.text_field :date, type: "date", required: true, class: "input w-full" %>
        </fieldset>
    </div>
    
    <fieldset class="fieldset">
      <%= form.label :prestation_type_id, "Prestation type", class: "fieldset-legend" %>
      <%= form.select :prestation_type_id, options_from_collection_for_select(current_user.organisation.prestation_types, 'id', 'nom', prestation.prestation_type_id), {}, { class: "select w-full" } %>
    </fieldset>
    <fieldset class="fieldset">
      <%= form.label :qté, class: "fieldset-legend" %>
      <%= form.number_field :qté, value: 1, step: :any, class: "input w-full" %>
    </fieldset>

    <%= form.submit "Enregistrer", class: "btn btn-outline btn-success" %>

<% end %>
