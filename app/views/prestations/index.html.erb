<div class="flex items-center pb-6 mt-6 mb-2">
  <h2 class="font-light inline mb-0 whitespace-nowrap">
    <%= mi_icon 'utensils', class: 'text-secondary' %> 
    Prestations consommées
  </h2>
  <%= link_to guide_path(anchor: "prestations") do %>
    <%= mi_icon 'question-circle', type: :regular, title: "Ouvrir l'aide", class: 'text-slate-400 mx-4 text-2xl' %>
  <% end %>
</div>

<%= form_with url: prestations_path, method: :get, class: '' do |f| %>
  <div class="flex flex-wrap -mx-2 items-center mb-6 p-4 mx-0 shadow-sm">
    <div class="flex-1 px-2">
      <fieldset class="fieldset">
        <%= f.label :nom, 'Nom/Prénom', class: "fieldset-legend" %>
        <%= f.text_field :nom, value: params[:nom], onchange: "this.form.submit()", autofocus: false, class: "input w-full" %>
      </fieldset>
    </div>
    <div class="w-full sm:w-2/12 px-2">
      <fieldset class="fieldset">
        <%= f.label :structure_id, "Structure", class: "fieldset-legend" %>
        <%= f.select :structure_id, options_from_collection_for_select(@structures, 'id', 'nom', params[:structure_id]), { include_blank: true }, { onchange: "this.form.submit()", class: "select w-full" } %>
      </fieldset>
    </div>
    <div class="w-full sm:w-2/12 px-2">
      <fieldset class="fieldset">
        <%= f.label :classroom_id, "Classe", class: "fieldset-legend" %>
        <%= f.select :classroom_id, options_from_collection_for_select(@classrooms, 'id', 'nom', params[:classroom_id]), { include_blank: true }, { onchange: "this.form.submit()", class: "select w-full" } %>
      </fieldset>
    </div>
    <div class="w-full sm:w-2/12 px-2">
      <fieldset class="fieldset">
        <%= f.label :date, class: "fieldset-legend" %>
        <%= f.date_field :date, value: params[:date], onchange: "this.form.submit()", class: "input w-full" %>
      </fieldset>
    </div>
    <div class="w-full sm:w-2/12 px-2">
      <fieldset class="fieldset">
        <%= f.label :prestation_type_id, "Type", class: "fieldset-legend" %>
        <%= f.select :prestation_type_id, options_from_collection_for_select(@prestation_types, 'id', 'nom', params[:prestation_type_id]), { include_blank: true }, { onchange: "this.form.submit()", class: "select w-full" } %>
      </fieldset>
    </div>
    <div class="w-full sm:w-2/12 px-2"><%= check_box_tag :archives, 'yes', params[:archives] == 'yes', class: 'checkbox checkbox-sm checkbox-primary', onchange: "this.form.submit()" %> Archives ?</div>
  </div>
<% end %>

<%= form_with url: action_prestations_path, method: :post do %>
  <div data-controller="action">
    <div class="overflow-x-auto">
      <table class="table border border-slate-200 shadow-sm">
        <thead>
          <tr class="text-warning">
            <th></th>
            <th><%= sort_link 'structures.nom', 'Structure' %></th>
            <th><%= sort_link 'classrooms.nom', 'Classe' %></th>
            <th><%= sort_link 'prestations.date', 'Date' %></th>
            <th><%= sort_link 'prestation_types.nom', 'Type' %></th>
            <th><%= sort_link 'enfants.nom', 'Nom' %></th>
            <th><%= sort_link 'enfants.prénom', 'Prénom' %></th>
            <th><%= sort_link 'prestations.qté', 'Qté' %></th>
            <th colspan=2></th>
          </tr>
        </thead>

        <tbody>
          <%=render @prestations.includes(:enfant, :prestation_type) %>
        </tbody>
      </table>

    </div>
    <div class="flex flex-wrap -mx-2">
      <div class="w-full sm:w-4/12 px-2">
        <div class="join">
          <%= select_tag :action_name, 
                          options_for_select(["Supprimer"]), 
                          include_blank: true, 
                          class: 'select select-bordered select-sm join-item w-full',
                          data: { 'action-target': 'selector' } %>
            <%= submit_tag 'ok',  name: 'action', 
                                  class: 'btn btn-sm btn-outline btn-success join-item',
                                  data: {'action-target': 'button'} %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<div class="mt-2">
  <%= page_entries_info @prestations, entry_name: 'prestation' %>
  <%= paginate @prestations %>
</div>
