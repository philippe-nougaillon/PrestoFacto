<div class="pb-2 mt-6 mb-2 border-b border-slate-200">
  <h2 class="font-light"><%= embedded_svg "icons/chat.svg", class: "w-5 h-5 inline align-[-2px]" %> Messages</h2>
</div>

<h3 class="fw-lighter mb-12">Ajoutez ici le message que vous voulez voir en bas de vos factures et e-mails d'accompagnement</h3>

<div class="overflow-x-auto w-full sm:w-6/12 px-2">
  <table class="table border border-slate-200 [&_th]:border [&_td]:border table-zebra table-sm">
    <thead>
      <tr>
        <th>Contenu</th>
        <th>Actif</th>
        <th colspan="2"></th>
      </tr>
    </thead>

    <tbody>
      <% @facture_messages.each do |facture_message| %>
        <tr class="row-hover">
          <td><%= facture_message.contenu %></td>
          <td class="text-center"><%= embedded_svg "icons/check.svg", class: "w-5 h-5 inline" if facture_message.actif %></td>
          <td class="text-center">
            <%= link_to edit_facture_message_path(facture_message) do %>
              <%= embedded_svg "icons/edit.svg", class: "w-5 h-5 inline" %>
            <% end %>
          </td>
          <td class="text-center">
            <%= button_to facture_message, method: :delete, 'data-turbo-confirm': 'Êtes-vous bien certain.e ???', class:'btn btn-sm btn-ghost' do %>
              <%= embedded_svg "icons/delete.svg", class: "w-5 h-5 text-error inline" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

<br>

<%= link_to new_facture_message_path, class: "btn btn-outline btn-primary" do %>
  <%= embedded_svg "icons/add_circle.svg", class: "w-5 h-5 inline" %> Ajouter un message
<% end %>
