<%= form_with(model: facture_message, local: true) do |form| %>
  <% if facture_message.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(facture_message.errors.count, "erreur") %> empêche(nt) la sauvegarde du message de facture :</h2>

      <ul>
        <% facture_message.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

    <%= form.hidden_field :organisation_id %>
    <fieldset class="fieldset">
      <%= form.label :contenu, class: "fieldset-legend" %>
      <%= form.text_field :contenu, class: "input w-full" %>
    </fieldset>
    <fieldset class="fieldset">
      <%= form.label :actif, class: "label" do %>
        <%= form.check_box :actif, class: "checkbox checkbox-primary" %>
        Actif
      <% end %>
    </fieldset>

  <div class="actions my-6">
    <%= form.submit "Enregistrer", class: "btn btn-outline btn-success" %>
  </div>
<% end %>
