<div class="nested-form-wrapper" data-new-record="<%= f.object.new_record? %>">
  <div class="flex flex-wrap -mx-2">
    <div class="w-full sm:w-8/12 px-2">
      <fieldset class="fieldset">
        <%= f.label :nom, class: "fieldset-legend" %>
        <%= f.text_field :nom, class: "input w-full" %>
      </fieldset>
    </div>
    <% unless f.object.classrooms.any? %>
      <div class="flex-1 px-2">
        <a type="button" data-action="nested-form#remove"><%= embedded_svg "icons/delete.svg", class: "w-5 h-5 text-error mt-2 inline" %></a>
      </div>
    <% end %>
  </div>
  <%= f.hidden_field :_destroy %>
</div>