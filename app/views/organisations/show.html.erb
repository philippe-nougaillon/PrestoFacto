<div class="pb-2 mt-6 mb-2 border-b border-slate-200">
  <h2 class="font-light"><%= embedded_svg "icons/location_city.svg", class: "w-5 h-5 inline align-[-3px]" %> Organisation</h2>
</div>

<p>
  <h2>
    <%= @organisation.nom %>
  </h2>
</p>
    
<div class="flex flex-wrap -mx-2">
  <div class="flex-1 px-2">
    <p>
      <strong>Adresse:</strong>
      <%= @organisation.adresse %>
    </p>

    <p>
      <strong>Ville:</strong>
      <%= @organisation.cp %> <%= @organisation.ville %>
    </p>

    <p>
      <strong>Téléphone:</strong>
      <%= @organisation.téléphone %>
    </p>

    <p>
      <strong>Email:</strong>
      <%= @organisation.email %>
    </p>

  </div>

  <div class="flex-1 px-2">
    <% if @organisation.logo.attached? %>
      <%= image_tag url_for(@organisation.logo), width: 150 %>
    <% end %>
  </div>
</div>

<div class="flex flex-wrap -mx-2 mt-4">
  <div class="flex-1 px-2">
    <h3><%= embedded_svg "icons/school.svg", class: "w-5 h-5 inline align-[-2px]" %> Structures</h3>
    <div class="overflow-x-auto">
      <table class="table border border-slate-200 [&_th]:border [&_td]:border table-sm">
        <thead>
          <tr>
            <th>Nom</th>
            <th>Classes</th>
            <th>Enfants</th>
            <th></th>
          </tr>
        </thead>

        <% @organisation.structures.each do |structure| %>
          <tr class="row-hover">
            <td><%= link_to structure.nom, structure %></td>
            <td><%= structure.classrooms.pluck(:nom).join(", ") %></td>
            <td><%= structure.enfants.size %></td>
            <td>
              <% if policy(structure).destroy? %>
                <%= button_to structure, method: :delete, 'data-turbo-confirm': 'Êtes-vous bien certain.e ???', class:'btn btn-sm btn-ghost' do %>
                  <%= embedded_svg "icons/delete.svg", class: "w-5 h-5 text-error inline" %>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>
    </div>
  </div>

  <div class="flex-1 px-2">
    <h3><%= embedded_svg "icons/beach_access.svg", class: "w-5 h-5 inline align-[-3px]" %> Vacances à venir en zone <%= @organisation.zone %></h3>
    <div class="overflow-x-auto">
      <table class="table border border-slate-200 [&_th]:border [&_td]:border table-sm">
        <thead>
          <tr>
            <th>Nom</th>
            <th>Début</th>
            <th>Fin</th>  
          </tr>
        </thead>

        <% @vacances.each do | vacance | %>
          <tr class="row-hover">
            <td><%= vacance.nom %></td>
            <td><%= l vacance.début %></td>
            <td><%= l vacance.fin if vacance.fin %></td>
          </tr>
        <% end %>
      </table>
    </div>
  </div>
</div>

<hr>

<% if policy(@organisation).edit? %>
  <%= link_to edit_organisation_path(@organisation), class: "btn btn-outline btn-primary" do %>
    <%= embedded_svg "icons/edit.svg", class: "w-5 h-5 inline" %> Éditer
  <% end %>
<% end %>