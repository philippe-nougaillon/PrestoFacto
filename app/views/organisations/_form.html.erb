<%= form_with(model: organisation, local: true) do |form| %>

  <div class="flex flex-wrap -mx-2">
    <div class="w-full sm:w-5/12 px-2">
      <%= form.text_field :nom %>
      <%= form.text_field :adresse %>
      <div class="flex flex-wrap -mx-2">
        <div class="w-full sm:w-3/12 px-2"><%= form.text_field :cp %></div>
        <div class="flex-1 px-2"><%= form.text_field :ville %></div>
      </div>
    </div>
    <div class="flex-1 px-2">
      <div class="flex flex-wrap -mx-2">
        <div class="w-full sm:w-4/12 px-2"><%= form.text_field :téléphone %></div>
        <div class="flex-1 px-2"><%= form.text_field :email %></div>
      </div>
      <div class="flex flex-wrap -mx-2">
        <div class="w-full sm:w-4/12 px-2"><%= form.select :zone, ['A', 'B', 'C'], { label: "Zone", help: "Zone de vacances scolaires", wrapper: { class: 'has-warning', data: { foo: 'bar' } } }, { class: "selectpicker" } %></div>
        <div class="flex-1 px-2"><%= form.file_field :logo, help: "Votre logo. Apparaît sur l'entête des documents", placeholder: "Choisir un fichier image" %></div>
      </div>
    </div>
  </div>
  <br>

  <div class="flex flex-wrap -mx-2">
    <div class="w-full sm:w-5/12 px-2">
      <h3><%= mi_icon 'school' %> Structures</h3>

      <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".nested-form-wrapper" >
        <template data-nested-form-target="template">
          <%= form.fields_for :structures, Structure.new, child_index: 'NEW_RECORD' do |structure_fields| %>
            <%= render "structure_form", f: structure_fields %>
          <% end %>
        </template>

        <%= form.fields_for :structures do |structure_fields| %>
          <%= render "structure_form", f: structure_fields %>
        <% end %>

        <!-- Inserted elements will be injected before that target. -->
        <div data-nested-form-target="target"></div>

        <button class="btn btn-outline btn-primary" type="button" data-action="nested-form#add"><%= mi_icon 'plus-circle' %> Ajouter une structure</button>
      </div>
    </div>
    
    <div class="flex-1 px-2">
      <h3><%= mi_icon 'umbrella-beach' %> Vacances spécifiques à votre organisation</h3>

      <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".nested-form-wrapper" >
        <template data-nested-form-target="template">
          <%= form.fields_for :vacances, Vacance.new, child_index: 'NEW_RECORD' do |vacance_fields| %>
            <%= render "vacance_form", f: vacance_fields %>
          <% end %>
        </template>

        <%= form.fields_for :vacances do |vacance_fields| %>
          <%= render "vacance_form", f: vacance_fields %>
        <% end %>

        <!-- Inserted elements will be injected before that target. -->
        <div data-nested-form-target="target"></div>

        <button class="btn btn-outline btn-primary" type="button" data-action="nested-form#add"><%= mi_icon 'plus-circle' %> Ajouter des vacances</button>
      </div>
    </div>
  </div>

  <%= form.submit "Enregistrer", class: "btn btn-outline btn-success mt-12" %>

<% end %>
<br>

<script type="application/javascript">
    $('input[type="file"]').change(function(e){
        var fileName = e.target.files[0].name;
        $('.custom-file-label').html(fileName);
    });
</script>