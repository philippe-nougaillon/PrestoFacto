<%= form_with(model: organisation, local: true) do |form| %>

  <div class="flex flex-wrap -mx-2">
    <div class="w-full sm:w-5/12 px-2">
      <fieldset class="fieldset">
        <%= form.label :nom, class: "fieldset-legend" %>
        <%= form.text_field :nom, class: "input w-full" %>
      </fieldset>
      <fieldset class="fieldset">
        <%= form.label :adresse, class: "fieldset-legend" %>
        <%= form.text_field :adresse, class: "input w-full" %>
      </fieldset>
      <div class="flex flex-wrap -mx-2">
        <div class="w-full sm:w-3/12 px-2">
          <fieldset class="fieldset">
            <%= form.label :cp, class: "fieldset-legend" %>
            <%= form.text_field :cp, class: "input w-full" %>
          </fieldset>
        </div>
        <div class="flex-1 px-2">
          <fieldset class="fieldset">
            <%= form.label :ville, class: "fieldset-legend" %>
            <%= form.text_field :ville, class: "input w-full" %>
          </fieldset>
        </div>
      </div>
    </div>
    <div class="flex-1 px-2">
      <div class="flex flex-wrap -mx-2">
        <div class="w-full sm:w-4/12 px-2">
          <fieldset class="fieldset">
            <%= form.label :téléphone, class: "fieldset-legend" %>
            <%= form.text_field :téléphone, class: "input w-full" %>
          </fieldset>
        </div>
        <div class="flex-1 px-2">
          <fieldset class="fieldset">
            <%= form.label :email, class: "fieldset-legend" %>
            <%= form.text_field :email, class: "input w-full" %>
          </fieldset>
        </div>
      </div>
      <div class="flex flex-wrap -mx-2">
        <div class="w-full sm:w-4/12 px-2">
          <fieldset class="fieldset">
            <%= form.label :zone, "Zone", class: "fieldset-legend" %>
            <%= form.select :zone, ['A', 'B', 'C'], {}, { class: "select w-full" } %>
            <p class="label">Zone de vacances scolaires</p>
          </fieldset>
        </div>
        <div class="flex-1 px-2">
          <fieldset class="fieldset">
            <%= form.label :logo, class: "fieldset-legend" %>
            <%= form.file_field :logo, placeholder: "Choisir un fichier image", class: "file-input w-full" %>
            <p class="label">Votre logo. Apparaît sur l&#39;entête des documents</p>
          </fieldset>
        </div>
      </div>
    </div>
  </div>
  <br>

  <div class="flex flex-wrap -mx-2">
    <div class="w-full sm:w-5/12 px-2">
      <h3><%= embedded_svg "icons/school.svg", class: "w-5 h-5 inline align-[-2px]" %> Structures</h3>

      <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".nested-form-wrapper" >
        <template data-nested-form-target="template">
          <%= form.fields_for :structures, Structure.new, child_index: 'NEW_RECORD' do |structure_fields| %>
            <%= render "structure_form", f: structure_fields %>
          <% end %>
        </template>

        <%= form.fields_for :structures do |structure_fields| %>
          <%= render "structure_form", f: structure_fields %>
        <% end %>

        <!-- Inserted elements will be injected before that target. -->
        <div data-nested-form-target="target"></div>

        <button class="btn btn-outline btn-primary" type="button" data-action="nested-form#add"><%= embedded_svg "icons/add_circle.svg", class: "w-5 h-5 inline" %> Ajouter une structure</button>
      </div>
    </div>
    
    <div class="flex-1 px-2">
      <h3><%= embedded_svg "icons/beach_access.svg", class: "w-5 h-5 inline align-[-3px]" %> Vacances spécifiques à votre organisation</h3>

      <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".nested-form-wrapper" >
        <template data-nested-form-target="template">
          <%= form.fields_for :vacances, Vacance.new, child_index: 'NEW_RECORD' do |vacance_fields| %>
            <%= render "vacance_form", f: vacance_fields %>
          <% end %>
        </template>

        <%= form.fields_for :vacances do |vacance_fields| %>
          <%= render "vacance_form", f: vacance_fields %>
        <% end %>

        <!-- Inserted elements will be injected before that target. -->
        <div data-nested-form-target="target"></div>

        <button class="btn btn-outline btn-primary" type="button" data-action="nested-form#add"><%= embedded_svg "icons/add_circle.svg", class: "w-5 h-5 inline" %> Ajouter des vacances</button>
      </div>
    </div>
  </div>

  <%= form.submit "Enregistrer", class: "btn btn-outline btn-success mt-12" %>

<% end %>
<br>

<script type="application/javascript">
    $('input[type="file"]').change(function(e){
        var fileName = e.target.files[0].name;
        $('.custom-file-label').html(fileName);
    });
</script>