<%# Locals : id, titre, largeur (optionnel). S'ouvre avec <id>.showModal(). %>
<dialog id="<%= id %>" class="modal">
  <div class="modal-box <%= local_assigns.fetch(:largeur, 'max-w-3xl') %>">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" aria-label="Fermer">✕</button>
    </form>
    <h3 class="text-lg font-bold mb-4"><%= titre %></h3>
    <%= yield %>
  </div>
  <form method="dialog" class="modal-backdrop"><button>Fermer</button></form>
</dialog>
