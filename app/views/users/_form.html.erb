<%= form_with(model: @user, url: '/users_admin', local: true) do |form| %>

  <% if user.errors.any? %>
    <div id="error_explanation">
      <h3><%= pluralize(user.errors.count, "erreur") %> empêche(nt) l'enregistrement de l'utilisateur :</h3>

      <ul>
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="w-full sm:w-5/12 px-2">
    <fieldset class="fieldset">
      <%= form.label :email, class: "fieldset-legend" %>
      <%= form.text_field :email, required: true, class: "input w-full" %>
    </fieldset>
    <fieldset class="fieldset">
      <%= form.label :password, 'Mot de passe', class: "fieldset-legend" %>
      <%= form.password_field :password, required: true, class: "input w-full" %>
    </fieldset>
    <fieldset class="fieldset">
      <%= form.label :password_confirmation, 'Confirmation du mot de passe', class: "fieldset-legend" %>
      <%= form.password_field :password_confirmation, required: true, class: "input w-full" %>
    </fieldset>
    <fieldset class="fieldset">
      <%= form.label :role, 'Rôle', class: "fieldset-legend" %>
      <%= form.select :role, options_for_select(User.roles.keys.to_a), {}, { class: "select w-full" } %>
    </fieldset>
    <br />

    <%= form.submit "Enregistrer", class: "btn btn-outline btn-success", 'data-turbo': false %>
  </div>

<% end %>
