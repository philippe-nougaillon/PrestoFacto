<div class="pb-2 mt-6 mb-2 border-b border-slate-200">
  <% if policy(User).new? %>
    <%= link_to new_users_admin_path, class: 'btn btn-outline btn-primary float-right' do %>
      <%= embedded_svg "icons/add_circle.svg", class: "w-5 h-5 inline" %> Ajouter un Utilisateur
    <% end %>
  <% end %>

  <h2 class="font-light inline"><%= embedded_svg "icons/groups.svg", class: "w-5 h-5 inline align-[-5px]" %> Utilisateurs / Accès portail parents</h2>
  <%= link_to guide_path(anchor: "portail") do %>
    <%= embedded_svg "icons/help.svg", class: "w-5 h-5 text-slate-500 mx-2 inline", title: "Ouvrir l'aide" %>
  <% end %>
</div>

<%= form_with url: users_admin_index_path, method: :get do |f| %>
  <fieldset class="fieldset">
    <%= f.label :search, 'Rechercher', class: "fieldset-legend" %>
    <%= f.text_field :search, value: params[:search], onchange: "this.form.submit()", class: "input w-full" %>
  </fieldset>
<% end %>

<div class="overflow-x-auto">
  <table class="table">
    <thead>
      <tr>
        <th>Email</th>
        <th>Rôle</th>
        <th colspan="3"></th>
      </tr>
    </thead>


    <tbody>
      <%= render @users %>
    </tbody>
  </table>
</div>

<%= page_entries_info @users, entry_name: 'utilisateur' %>
<%= paginate @users %>
